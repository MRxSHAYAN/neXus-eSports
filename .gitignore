# ───────────────────────────────────────────
#  NEXUS ESPORTS — Root .gitignore
# ───────────────────────────────────────────

# ── Node Modules ────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Environment Variables ───────────────────
.env
.env.local
.env.development
.env.production
.env.staging
backend/.env
*.env

# ── Frontend Build Output ───────────────────
frontend/dist/
frontend/.output/
frontend/.astro/

# ── Backend Uploads ─────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS / Editor Junk ────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── Editor Config ───────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# ── Temp / Cache ────────────────────────────
.cache/
.temp/
.tmp/
*.tmp
*.bak
*.swp

# ── Explanation & Private Text Files ────────
HOW_IT_WORKS.txt
EXPLANATION.txt
*.txt

