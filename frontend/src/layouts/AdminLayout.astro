---
import '../styles/global.css';

interface Props {
  title: string;
  activePage?: 'dashboard' | 'tournaments' | 'teams' | 'settings';
}

const { title, activePage = 'dashboard' } = Astro.props;

const navItems = [
  {
    id: 'dashboard',
    label: 'Dashboard',
    href: '/admin',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    id: 'tournaments',
    label: 'Tournaments',
    href: '/admin/tournaments',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/></svg>`,
  },
  {
    id: 'teams',
    label: 'Registered Teams',
    href: '/admin/teams',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
  {
    id: 'settings',
    label: 'Settings',
    href: '/admin/settings',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>`,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} — NEXUS Admin</title>
  </head>
  <body style="background: var(--bg-dark);">

    <!-- ── Auth guard — runs before any paint ── -->
    <script is:inline>
      (function() {
        const token = localStorage.getItem('nexus_admin_token');
        if (!token || token !== 'nexus_admin_authenticated') {
          window.location.replace('/admin/login');
        }
      })();
    </script>

    <div class="flex min-h-screen" id="admin-shell" style="opacity:0; transition: opacity .2s ease;">

      <!-- ═══════════════════════════════════════
           SIDEBAR
      ═══════════════════════════════════════ -->
      <aside
        id="admin-sidebar"
        class="fixed top-0 left-0 h-full z-40 flex flex-col transition-transform duration-300"
        style="width: 256px; background: #080A0F; border-right: 1px solid rgba(0,255,42,0.1);"
        aria-label="Admin sidebar"
      >
        <!-- Brand -->
        <div class="flex items-center gap-3 px-5 py-5 border-b" style="border-color: rgba(0,255,42,0.08);">
          <img src="/neXus_eSport_icon-removebg-preview.png" alt="" width="32" height="32" class="w-8 h-8 object-contain" style="filter: drop-shadow(0 0 6px #00FF2A);" />
          <div class="leading-tight">
            <p class="font-tech font-700 text-sm tracking-widest uppercase" style="color: var(--neon);">NEXUS</p>
            <p class="font-tech text-[10px] tracking-[.18em] uppercase text-gray-500">Admin Panel</p>
          </div>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto" aria-label="Admin navigation">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`admin-nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg font-tech text-sm tracking-wide transition-all duration-200 group
                ${activePage === item.id
                  ? 'text-white'
                  : 'text-gray-500 hover:text-white hover:bg-white/5'
                }`}
              style={activePage === item.id ? 'background: rgba(0,255,42,0.1); color: var(--neon); border-left: 2px solid var(--neon);' : ''}
              aria-current={activePage === item.id ? 'page' : undefined}
            >
              <span set:html={item.icon} class={activePage === item.id ? '' : 'opacity-60 group-hover:opacity-100'} />
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Logout -->
        <div class="px-3 py-4 border-t" style="border-color: rgba(255,255,255,0.06);">
          <button
            id="admin-logout-btn"
            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg font-tech text-sm tracking-wide text-gray-500 hover:text-red-400 transition-all duration-200 group"
            style="background: transparent;"
            onmouseenter="this.style.background='rgba(248,113,113,0.08)'"
            onmouseleave="this.style.background='transparent'"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="opacity-60 group-hover:opacity-100"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Logout
          </button>
        </div>
      </aside>

      <!-- ── Overlay for mobile ── -->
      <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 z-30 hidden" aria-hidden="true"></div>

      <!-- ═══════════════════════════════════════
           MAIN AREA
      ═══════════════════════════════════════ -->
      <div class="flex-1 flex flex-col min-h-screen" style="margin-left: 256px;" id="admin-main">

        <!-- TOP BAR -->
        <header class="sticky top-0 z-20 flex items-center justify-between px-6 py-3.5" style="background: rgba(8,10,15,0.9); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255,255,255,0.06); min-height: 60px;">

          <!-- Mobile hamburger + title -->
          <div class="flex items-center gap-3">
            <button
              id="sidebar-toggle"
              class="md:hidden w-8 h-8 flex flex-col justify-center items-center gap-[5px] rounded hover:bg-white/5 transition-colors"
              aria-label="Toggle sidebar"
            >
              <span class="w-5 h-[1.5px] bg-white rounded-full"></span>
              <span class="w-3.5 h-[1.5px] bg-white rounded-full"></span>
              <span class="w-5 h-[1.5px] bg-white rounded-full"></span>
            </button>
            <h1 class="font-tech font-700 text-sm tracking-[.15em] uppercase text-white">{title}</h1>
          </div>

          <!-- Right cluster -->
          <div class="flex items-center gap-4">
            <!-- Live date -->
            <div class="hidden sm:flex items-center gap-2 text-gray-500 font-tech text-xs tracking-wide">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span id="topbar-date"></span>
            </div>
            <!-- Admin pill -->
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-full" style="background: rgba(0,255,42,0.08); border: 1px solid rgba(0,255,42,0.2);">
              <div class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-tech font-700" style="background: var(--neon); color: #05070A;">A</div>
              <span class="font-tech text-xs tracking-wide" style="color: var(--neon);">admin</span>
            </div>
          </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="flex-1 p-5 sm:p-6 lg:p-8" id="admin-page-content">
          <slot />
        </main>

      </div>
    </div>

  </body>
</html>

<script>
  // Show shell only after auth check passes
  document.addEventListener('DOMContentLoaded', () => {
    const shell = document.getElementById('admin-shell');
    if (shell) shell.style.opacity = '1';

    // Live date in topbar
    const dateEl = document.getElementById('topbar-date');
    if (dateEl) {
      const now = new Date();
      dateEl.textContent = now.toLocaleDateString('en-US', {
        weekday: 'short', month: 'short', day: 'numeric', year: 'numeric'
      });
    }

    // Logout
    document.getElementById('admin-logout-btn')?.addEventListener('click', () => {
      localStorage.removeItem('nexus_admin_token');
      window.location.href = '/admin/login';
    });

    // Mobile sidebar toggle
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('sidebar-overlay');
    const toggleBtn = document.getElementById('sidebar-toggle');
    const mainArea = document.getElementById('admin-main');
    let sidebarOpen = false;

    function openSidebar() {
      sidebarOpen = true;
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
    }
    function closeSidebar() {
      sidebarOpen = false;
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('hidden');
    }

    toggleBtn?.addEventListener('click', () => sidebarOpen ? closeSidebar() : openSidebar());
    overlay?.addEventListener('click', closeSidebar);

    // Responsive: hide sidebar on mobile by default
    function handleResize() {
      if (window.innerWidth < 768) {
        sidebar?.classList.add('-translate-x-full');
        if (mainArea) mainArea.style.marginLeft = '0';
      } else {
        sidebar?.classList.remove('-translate-x-full');
        if (mainArea) mainArea.style.marginLeft = '256px';
        overlay?.classList.add('hidden');
        sidebarOpen = false;
      }
    }

    handleResize();
    window.addEventListener('resize', handleResize);
  });
</script>
