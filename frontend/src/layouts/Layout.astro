---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'NEXUS ESPORTS — The premier PUBG Mobile tournament organizer. Compete, dominate, and claim your glory.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00FF2A" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // ── Scroll-reveal observer ──────────────────────────────────────────
  const revealEls = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  revealEls.forEach(el => observer.observe(el));

  // ── Page transitions (View Transitions API) ────────────────────────
  // Intercept all same-origin link clicks
  document.addEventListener('click', async (e) => {
    const anchor = (e.target as Element).closest('a');
    if (!anchor) return;

    const href = anchor.getAttribute('href');
    if (!href) return;

    // Only handle same-origin relative links, skip hash/external
    const isSameOrigin =
      href.startsWith('/') &&
      !href.startsWith('//') &&
      !anchor.hasAttribute('target');

    if (!isSameOrigin) return;

    // Skip if already on that page
    if (window.location.pathname === href || window.location.pathname === href + '/') return;

    e.preventDefault();

    // Use View Transitions API if available
    if ('startViewTransition' in document) {
      // @ts-ignore
      document.startViewTransition(async () => {
        window.location.href = href;
      });
    } else {
      window.location.href = href;
    }
  });
</script>
