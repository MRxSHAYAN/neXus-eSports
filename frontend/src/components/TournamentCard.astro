---
interface Props {
  _id?: string;
  id?: string;
  title: string;
  gameName?: string;
  gameMode?: string;
  perPersonFee?: number | string;
  teamFee?: number | string;
  prizePool?: string;
  maxSlots?: number | string;
  status?: string;
  date?: string;
  description?: string;
}

const {
  _id,
  id,
  title,
  gameName = 'PUBG Mobile',
  gameMode = 'Squad (4v4)',
  perPersonFee = 0,
  teamFee = 0,
  prizePool = 'TBD',
  maxSlots = 16,
  status = 'Active',
  date,
  description,
} = Astro.props;

const tournamentId = _id || id || '';

const isActive   = status === 'Active'   || status === 'active'   || status === 'live' || status === 'Open';
const isDisabled = status === 'Disabled' || status === 'disabled' || status === 'closed';

const badgeLabel = isActive ? '● OPEN'    : '✕ CLOSED';
const badgeClass = isActive ? 'badge-live' : 'badge-closed';
const accentColor = isActive ? 'bg-neon shadow-neon-sm' : 'bg-gray-600';

const ppFee = Number(perPersonFee) || 0;
const tFee  = Number(teamFee)      || 0;

const registerHref = isActive
  ? (tournamentId ? `/register?tournamentId=${tournamentId}` : '/register')
  : '#';
---

<article class="card-dark rounded-xl overflow-hidden group hover:card-neon-border transition-all duration-300 flex flex-col">

  <!-- Top accent bar -->
  <div class={`h-0.5 w-full ${accentColor}`}></div>

  <div class="p-5 flex flex-col flex-1 gap-4">

    <!-- Header row -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex-1 min-w-0">
        <span class="font-tech text-xs tracking-widest uppercase block mb-1" style="color: rgba(0,255,42,0.6);">{gameName}</span>
        <h3 class="font-tech font-700 text-lg leading-tight text-white group-hover:text-neon transition-colors duration-200 uppercase tracking-wide truncate" title={title}>
          {title}
        </h3>
        {gameMode && (
          <span class="font-tech text-xs text-gray-500 tracking-wide mt-0.5 block">{gameMode}</span>
        )}
      </div>
      <span class={`${badgeClass} font-tech text-xs font-700 tracking-widest uppercase px-2.5 py-1 rounded flex-shrink-0`}>
        {badgeLabel}
      </span>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 gap-3">

      <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
        <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Prize Pool</p>
        <p class="text-neon font-tech font-700 text-base leading-tight">{prizePool}</p>
      </div>

      <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
        <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Total Slots</p>
        <p class="text-white font-tech font-600 text-base leading-tight">{maxSlots} Slots</p>
      </div>

      <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
        <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Per Person Fee</p>
        <p class="text-white font-tech font-600 text-base leading-tight">
          {ppFee === 0 ? 'Free' : `PKR ${ppFee}`}
        </p>
      </div>

      <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
        <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Team Fee</p>
        <p class="text-white font-tech font-600 text-base leading-tight">
          {tFee === 0 ? 'Free' : `PKR ${tFee}`}
        </p>
      </div>

    </div>

    <!-- Date row -->
    {date && (
      <div class="flex items-center gap-2 text-gray-400 text-xs">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span class="font-tech tracking-wide">{date}</span>
      </div>
    )}

    {description && (
      <p class="text-gray-500 text-xs font-tech leading-relaxed line-clamp-2">{description}</p>
    )}

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- CTA -->
    <a
      href={registerHref}
      class={`block text-center py-2.5 rounded font-tech font-700 text-sm tracking-widest uppercase transition-all duration-200
        ${isActive
          ? 'btn-neon shadow-neon-sm'
          : 'bg-white/5 text-gray-500 cursor-not-allowed border border-white/10'
        }`}
      aria-disabled={!isActive}
      tabindex={isActive ? 0 : -1}
    >
      {isActive ? 'Register Now' : 'Registration Closed'}
    </a>

  </div>
</article>
