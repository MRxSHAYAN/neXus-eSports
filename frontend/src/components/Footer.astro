---
const quickLinks = [
  { label: 'Home',        href: '/'            },
  { label: 'Tournaments', href: '/tournaments' },
  { label: 'Rules',       href: '/rules'       },
  { label: 'Register',    href: '/register'    },
  { label: 'Contact',     href: '/contact'     },
];

const year = new Date().getFullYear();
---

<footer class="bg-[#0B0D12] border-t border-white/10 mt-auto">

  <div class="divider-neon"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- Brand -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3 group w-fit">
          <img
            src="/neXus_eSport_icon-removebg-preview.png"
            alt="NEXUS ESPORTS"
            width="32"
            height="32"
            class="w-8 h-8 object-contain group-hover:drop-shadow-[0_0_8px_#00FF2A] transition-all"
          />
          <span class="font-tech font-700 text-lg tracking-widest uppercase">
            <span class="text-neon">NEXUS</span> ESPORTS
          </span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed max-w-xs">
          The premier PUBG Mobile tournament organizer. Compete, rise through the ranks, and dominate the battlegrounds.
        </p>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-tech tracking-widest uppercase text-neon animate-neon-pulse">
            <span class="w-1.5 h-1.5 rounded-full bg-neon inline-block"></span>
            Servers Online
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-tech font-700 text-sm tracking-widest uppercase text-white mb-5">Quick Links</h3>
        <ul class="space-y-2.5">
          {quickLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-neon text-sm transition-colors duration-200 flex items-center gap-2 group"
              >
                <span class="w-3 h-px bg-neon opacity-0 group-hover:opacity-100 transition-opacity duration-200"></span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="font-tech font-700 text-sm tracking-widest uppercase text-white mb-5">Join Our Community</h3>
        <div class="space-y-3">
          <a
            href="https://discord.gg/nexusesports"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-[#5865F2]/10 border border-[#5865F2]/30 text-[#5865F2] hover:bg-[#5865F2]/20 hover:border-[#5865F2]/60 px-4 py-3 rounded transition-all duration-200 text-sm font-tech font-600 tracking-wide"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Discord Server
          </a>

          <a
            href="https://chat.whatsapp.com/nexusesports"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-[#25D366]/10 border border-[#25D366]/30 text-[#25D366] hover:bg-[#25D366]/20 hover:border-[#25D366]/60 px-4 py-3 rounded transition-all duration-200 text-sm font-tech font-600 tracking-wide"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp Group
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2">
      <p class="text-gray-500 text-xs font-tech tracking-wide">
        &copy; {year} <span class="text-neon">NEXUS ESPORTS</span>. All rights reserved.
      </p>
      <p class="text-gray-600 text-xs">
        Built for the battlegrounds. PUBG Mobile Tournament Organizer.
      </p>
    </div>
  </div>

</footer>
