---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Tournaments – NEXUS ESPORTS"
  description="Browse all tournaments hosted by NEXUS ESPORTS. Live lobbies, upcoming events, and registration details."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="tournaments-heading">
    <div class="max-w-7xl mx-auto">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">All Events</span>
      <h1 id="tournaments-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Tournament <span class="text-neon">Schedule</span>
      </h1>
      <p class="text-gray-400 max-w-xl mb-8">
        All active tournaments. Register before slots fill up — slots are limited.
      </p>
      <!-- Summary stats (populated by JS) -->
      <div class="flex flex-wrap gap-4" id="stats-row">
        <div class="badge-live font-tech text-xs font-700 tracking-widest uppercase px-3 py-1.5 rounded" id="stat-active">— Active</div>
        <div class="badge-closed font-tech text-xs font-700 tracking-widest uppercase px-3 py-1.5 rounded" id="stat-closed">— Closed</div>
      </div>
    </div>
  </section>

  <!-- Tournaments Grid -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-label="Tournament listings">
    <div class="max-w-7xl mx-auto">

      <!-- Loading state -->
      <div id="loading-state" class="text-center py-20">
        <div class="inline-block w-8 h-8 border-2 border-neon border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="font-tech text-sm text-gray-400 tracking-widest uppercase">Loading tournaments...</p>
      </div>

      <!-- Error state -->
      <div id="error-state" class="hidden text-center py-20">
        <p class="font-tech text-sm text-red-400 mb-3">Could not load tournaments. Please start the backend server.</p>
        <button onclick="loadTournaments()" class="btn-outline-neon px-5 py-2 rounded text-xs tracking-widest">Retry</button>
      </div>

      <!-- Empty state -->
      <div id="empty-state" class="hidden text-center py-20">
        <p class="font-tech text-sm text-gray-500 mb-2">No tournaments have been created yet.</p>
        <p class="text-gray-600 text-xs font-tech">Admin can add tournaments from the dashboard.</p>
      </div>

      <!-- Active tournaments -->
      <div id="active-section" class="hidden mb-12">
        <h2 class="font-tech font-700 text-xl uppercase tracking-widest text-neon mb-6 flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse inline-block"></span>
          Open Registrations
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="active-grid"></div>
      </div>

      <div id="divider-section" class="hidden divider-neon mb-12"></div>

      <!-- Disabled tournaments -->
      <div id="closed-section" class="hidden">
        <h2 class="font-tech font-700 text-xl uppercase tracking-widest text-gray-500 mb-6 flex items-center gap-3">
          <span class="w-2 h-2 rounded bg-gray-500 inline-block"></span>
          Registration Closed
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-70" id="closed-grid"></div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 px-4 sm:px-6 lg:px-8 border-t border-white/5" aria-label="Registration CTA">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-gray-400 mb-4">
        Don't see a slot that fits? Join our WhatsApp Channel for flash tournaments and private lobbies.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/register" class="btn-neon px-6 py-3 rounded text-sm shadow-neon-sm">Register Now</a>
        <a href="/contact" class="btn-outline-neon px-6 py-3 rounded text-sm">Contact Admin</a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const API_BASE = 'http://localhost:5000/api';

  function buildCard(t: any): string {
    const isActive  = t.status === 'Active';
    const ppFee     = Number(t.perPersonFee) || 0;
    const tFee      = Number(t.teamFee) || 0;
    const id        = t._id || t.id || '';
    const registerHref = isActive
      ? (id ? `/register?tournamentId=${id}` : '/register')
      : '#';

    const accentColor = isActive ? 'bg-neon shadow-neon-sm' : 'bg-gray-600';
    const badgeClass  = isActive ? 'badge-live'   : 'badge-closed';
    const badgeLabel  = isActive ? '● OPEN'       : '✕ CLOSED';
    const ctaClass    = isActive
      ? 'btn-neon shadow-neon-sm'
      : 'bg-white/5 text-gray-500 cursor-not-allowed border border-white/10';
    const ctaLabel    = isActive ? 'Register Now' : 'Registration Closed';
    const ctaDisabled = isActive ? '' : 'aria-disabled="true" tabindex="-1"';

    const dateHtml = t.date ? `
      <div class="flex items-center gap-2 text-gray-400 text-xs">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <span class="font-tech tracking-wide">${t.date}</span>
      </div>` : '';

    const descHtml = t.description ? `<p class="text-gray-500 text-xs font-tech leading-relaxed line-clamp-2">${t.description}</p>` : '';

    return `
      <article class="card-dark rounded-xl overflow-hidden group hover:card-neon-border transition-all duration-300 flex flex-col">
        <div class="h-0.5 w-full ${accentColor}"></div>
        <div class="p-5 flex flex-col flex-1 gap-4">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <span class="font-tech text-xs tracking-widest uppercase block mb-1" style="color: rgba(0,255,42,0.6);">${t.gameName || 'PUBG Mobile'}</span>
              <h3 class="font-tech font-700 text-lg leading-tight text-white group-hover:text-neon transition-colors duration-200 uppercase tracking-wide truncate" title="${t.title}">${t.title}</h3>
              ${t.gameMode ? `<span class="font-tech text-xs text-gray-500 tracking-wide mt-0.5 block">${t.gameMode}</span>` : ''}
            </div>
            <span class="${badgeClass} font-tech text-xs font-700 tracking-widest uppercase px-2.5 py-1 rounded flex-shrink-0">${badgeLabel}</span>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
              <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Prize Pool</p>
              <p class="text-neon font-tech font-700 text-base leading-tight">${t.prizePool || 'TBD'}</p>
            </div>
            <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
              <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Total Slots</p>
              <p class="text-white font-tech font-600 text-base leading-tight">${t.maxSlots || 16} Slots</p>
            </div>
            <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
              <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Per Person Fee</p>
              <p class="text-white font-tech font-600 text-base leading-tight">${ppFee === 0 ? 'Free' : 'PKR ' + ppFee}</p>
            </div>
            <div class="bg-white/[0.03] rounded-lg px-3 py-2.5 border border-white/5">
              <p class="text-gray-500 text-[10px] font-tech tracking-widest uppercase mb-0.5">Team Fee</p>
              <p class="text-white font-tech font-600 text-base leading-tight">${tFee === 0 ? 'Free' : 'PKR ' + tFee}</p>
            </div>
          </div>
          ${dateHtml}
          ${descHtml}
          <div class="flex-1"></div>
          <a href="${registerHref}" class="block text-center py-2.5 rounded font-tech font-700 text-sm tracking-widest uppercase transition-all duration-200 ${ctaClass}" ${ctaDisabled}>
            ${ctaLabel}
          </a>
        </div>
      </article>`;
  }

  async function loadTournaments() {
    const loadingEl  = document.getElementById('loading-state')!;
    const errorEl    = document.getElementById('error-state')!;
    const emptyEl    = document.getElementById('empty-state')!;
    const activeSection = document.getElementById('active-section')!;
    const closedSection = document.getElementById('closed-section')!;
    const dividerEl     = document.getElementById('divider-section')!;
    const activeGrid    = document.getElementById('active-grid')!;
    const closedGrid    = document.getElementById('closed-grid')!;
    const statActive    = document.getElementById('stat-active')!;
    const statClosed    = document.getElementById('stat-closed')!;

    loadingEl.classList.remove('hidden');
    errorEl.classList.add('hidden');
    emptyEl.classList.add('hidden');
    activeSection.classList.add('hidden');
    closedSection.classList.add('hidden');
    dividerEl.classList.add('hidden');

    try {
      const res  = await fetch(`${API_BASE}/tournaments`);
      if (!res.ok) throw new Error('API error');
      const data = await res.json();
      if (!data.success) throw new Error('Bad response');

      loadingEl.classList.add('hidden');

      const tournaments: any[] = data.data || [];

      if (tournaments.length === 0) {
        emptyEl.classList.remove('hidden');
        statActive.textContent = '0 Active';
        statClosed.textContent = '0 Closed';
        return;
      }

      const active  = tournaments.filter((t: any) => t.status === 'Active');
      const closed  = tournaments.filter((t: any) => t.status !== 'Active');

      statActive.textContent = `${active.length} Active`;
      statClosed.textContent = `${closed.length} Closed`;

      if (active.length > 0) {
        activeGrid.innerHTML = active.map(buildCard).join('');
        activeSection.classList.remove('hidden');
      }

      if (active.length > 0 && closed.length > 0) {
        dividerEl.classList.remove('hidden');
      }

      if (closed.length > 0) {
        closedGrid.innerHTML = closed.map(buildCard).join('');
        closedSection.classList.remove('hidden');
      }

    } catch (err) {
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  // Expose for retry button
  (window as any).loadTournaments = loadTournaments;

  document.addEventListener('DOMContentLoaded', loadTournaments);
</script>
