---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'When is the room ID shared?',
    a: 'Room ID and password are shared on Discord and WhatsApp 30 minutes before the scheduled match time.',
  },
  {
    q: 'Can I change my squad roster after registration?',
    a: 'Rosters are locked 1 hour before the tournament. Contact an admin before the lock deadline for any changes.',
  },
  {
    q: 'How are prize winnings paid out?',
    a: 'Prize money is transferred via EasyPaisa or JazzCash to the team captain within 48 hours of the final results.',
  },
  {
    q: 'What happens if a player disconnects mid-match?',
    a: 'Disconnections are not valid grounds for a restart (unless caused by a server-side issue). The team must continue with remaining players.',
  },
  {
    q: 'Are there restrictions on which server to play on?',
    a: 'All players should connect to the Asia server unless specified otherwise by the admins for a particular tournament.',
  },
];
---

<Layout
  title="Contact & Community – NEXUS ESPORTS"
  description="Join the NEXUS ESPORTS community on Discord and WhatsApp. Get tournament support, room details, and updates."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="contact-heading">
    <div class="max-w-4xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Support & Community</span>
      <h1 id="contact-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Join the <span class="text-neon">Community</span>
      </h1>
      <p class="text-gray-400 max-w-xl mx-auto">
        All tournament updates, room IDs, results, and admin support are delivered through our official Discord and WhatsApp channels.
        Join now to stay in the loop.
      </p>
    </div>
  </section>

  <!-- Community Links -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="community-heading">
    <div class="max-w-4xl mx-auto">

      <h2 id="community-heading" class="font-tech font-700 text-xl uppercase tracking-widest text-white mb-8 flex items-center gap-3">
        <div class="w-1 h-6 bg-neon rounded"></div>
        Official Channels
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-14">

        <!-- Discord Card -->
        <a
          href="https://discord.gg/nexusesports"
          target="_blank"
          rel="noopener noreferrer"
          class="card-dark rounded-2xl p-7 border border-[#5865F2]/25 hover:border-[#5865F2]/60 hover:bg-[#5865F2]/5 transition-all duration-300 group block"
          aria-label="Join NEXUS ESPORTS Discord server (opens in new tab)"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 rounded-xl bg-[#5865F2]/20 border border-[#5865F2]/30 flex items-center justify-center group-hover:shadow-[0_0_16px_rgba(88,101,242,0.4)] transition-all">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#5865F2" aria-hidden="true">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500 group-hover:text-[#5865F2] transition-colors mt-1" aria-hidden="true">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </div>

          <h3 class="font-tech font-700 text-xl text-white uppercase tracking-wide mb-2 group-hover:text-[#5865F2] transition-colors">
            Discord Server
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            Primary hub for tournament announcements, room IDs, live results, admin support, and community discussion.
          </p>

          <ul class="space-y-1.5 mb-5">
            {[
              'Tournament announcements',
              'Room ID & password drops',
              'Results and leaderboards',
              '24/7 admin support',
            ].map(item => (
              <li class="flex items-center gap-2 text-gray-400 text-xs font-tech tracking-wide">
                <span class="w-1 h-1 rounded-full bg-[#5865F2] flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="btn-outline-neon w-full text-center py-2.5 rounded text-sm" style="border-color: #5865F2; color: #5865F2;">
            Join Discord →
          </div>
        </a>

        <!-- WhatsApp Card -->
        <a
          href="https://chat.whatsapp.com/nexusesports"
          target="_blank"
          rel="noopener noreferrer"
          class="card-dark rounded-2xl p-7 border border-[#25D366]/25 hover:border-[#25D366]/60 hover:bg-[#25D366]/5 transition-all duration-300 group block"
          aria-label="Join NEXUS ESPORTS WhatsApp group (opens in new tab)"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 rounded-xl bg-[#25D366]/15 border border-[#25D366]/30 flex items-center justify-center group-hover:shadow-[0_0_16px_rgba(37,211,102,0.3)] transition-all">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500 group-hover:text-[#25D366] transition-colors mt-1" aria-hidden="true">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </div>

          <h3 class="font-tech font-700 text-xl text-white uppercase tracking-wide mb-2 group-hover:text-[#25D366] transition-colors">
            WhatsApp Group
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            For quick updates, room password reminders, and direct admin contact. Best for players who prefer WhatsApp.
          </p>

          <ul class="space-y-1.5 mb-5">
            {[
              'Quick room ID reminders',
              'Match schedule alerts',
              'Direct admin contact',
              'Flash tournament alerts',
            ].map(item => (
              <li class="flex items-center gap-2 text-gray-400 text-xs font-tech tracking-wide">
                <span class="w-1 h-1 rounded-full bg-[#25D366] flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="w-full text-center py-2.5 rounded text-sm font-tech font-700 tracking-widest uppercase transition-all border" style="border-color: #25D366; color: #25D366;">
            Join WhatsApp →
          </div>
        </a>

      </div>

      <!-- FAQ Section -->
      <div class="divider-neon mb-10"></div>

      <h2 class="font-tech font-700 text-xl uppercase tracking-widest text-white mb-6 flex items-center gap-3" id="faq-heading">
        <div class="w-1 h-6 bg-neon/50 rounded"></div>
        Frequently Asked Questions
      </h2>

      <div class="space-y-3" role="list" aria-labelledby="faq-heading">
        {faqs.map((faq, i) => (
          <details class="card-dark rounded-xl border border-white/8 group" role="listitem">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none hover:bg-white/[0.025] rounded-xl transition-colors">
              <span class="font-tech font-700 text-white text-sm tracking-wide pr-4 group-open:text-neon transition-colors">
                {faq.q}
              </span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 text-gray-500 group-open:rotate-180 group-open:text-neon transition-all duration-200" aria-hidden="true">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-400 text-sm leading-relaxed border-t border-white/5 pt-3">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

      <!-- Still need help? -->
      <div class="mt-10 card-dark rounded-xl p-6 border border-neon/15 text-center">
        <p class="text-gray-300 text-sm mb-1">Still have questions?</p>
        <p class="text-gray-400 text-sm mb-4">
          Drop a message in <span class="text-[#5865F2] font-tech font-700">#support</span> on Discord and an admin will respond within a few hours.
        </p>
        <a
          href="https://discord.gg/nexusesports"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-neon inline-block px-6 py-2.5 rounded text-sm shadow-neon-sm"
        >
          Open Discord Support
        </a>
      </div>

    </div>
  </section>

</Layout>
