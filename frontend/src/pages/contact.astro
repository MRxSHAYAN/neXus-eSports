---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: 'When is the room ID shared?',
    a: 'Room ID and password are shared on our WhatsApp Channel and WhatsApp Group 30 minutes before the scheduled match time.',
  },
  {
    q: 'Can I change my squad roster after registration?',
    a: 'Rosters are locked 1 hour before the tournament. Contact an admin on WhatsApp before the lock deadline for any changes.',
  },
  {
    q: 'How are prize winnings paid out?',
    a: 'Prize money is transferred via EasyPaisa, JazzCash, or SadaPay to the team captain within 48 hours of the final results.',
  },
  {
    q: 'What happens if a player disconnects mid-match?',
    a: 'Disconnections are not valid grounds for a restart (unless caused by a server-side issue). The team must continue with remaining players.',
  },
  {
    q: 'Are there restrictions on which server to play on?',
    a: 'All players should connect to the Asia server unless specified otherwise by the admins for a particular tournament.',
  },
  {
    q: 'Where do I get the Room ID and password?',
    a: 'Room details are posted exclusively on our official WhatsApp Channel. Join the channel to receive instant tournament updates.',
  },
];
---

<Layout
  title="Contact & Community – NEXUS ESPORTS"
  description="Follow NEXUS ESPORTS on Instagram and join our WhatsApp community for tournament updates, room IDs, and admin support."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="contact-heading">
    <div class="max-w-4xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Support & Community</span>
      <h1 id="contact-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Join the <span class="text-neon">Community</span>
      </h1>
      <p class="text-gray-400 max-w-xl mx-auto">
        All tournament updates, room IDs, results, and admin support are delivered through our official Instagram and WhatsApp channels.
        Follow and join now to stay in the loop.
      </p>
    </div>
  </section>

  <!-- Community Links -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="community-heading">
    <div class="max-w-4xl mx-auto">

      <h2 id="community-heading" class="font-tech font-700 text-xl uppercase tracking-widest text-white mb-8 flex items-center gap-3">
        <div class="w-1 h-6 bg-neon rounded"></div>
        Official Channels
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-14">

        <!-- Instagram Card -->
        <a
          href="https://www.instagram.com/nexus.esports.pk"
          target="_blank"
          rel="noopener noreferrer"
          class="card-dark rounded-2xl p-7 border hover:bg-[#E1306C]/5 transition-all duration-300 group block"
          style="border-color: rgba(225,48,108,0.25);"
          aria-label="Follow NEXUS ESPORTS on Instagram (opens in new tab)"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center transition-all group-hover:shadow-[0_0_16px_rgba(225,48,108,0.4)]"
              style="background: rgba(225,48,108,0.15); border: 1px solid rgba(225,48,108,0.3);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#E1306C" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500 group-hover:text-[#E1306C] transition-colors mt-1" aria-hidden="true">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </div>

          <h3 class="font-tech font-700 text-xl text-white uppercase tracking-wide mb-2 group-hover:text-[#E1306C] transition-colors">
            Instagram
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            Follow us for tournament announcements, highlights, results, and behind-the-scenes content.
          </p>

          <ul class="space-y-1.5 mb-5">
            {[
              'Tournament announcements',
              'Highlight reels & results',
              'Event photos & updates',
              'Season announcements',
            ].map(item => (
              <li class="flex items-center gap-2 text-gray-400 text-xs font-tech tracking-wide">
                <span class="w-1 h-1 rounded-full flex-shrink-0" style="background: #E1306C;"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="w-full text-center py-2.5 rounded text-sm font-tech font-700 tracking-widest uppercase transition-all border" style="border-color: #E1306C; color: #E1306C;">
            Follow on Instagram →
          </div>
        </a>

        <!-- WhatsApp Direct -->
        <a
          href="https://wa.me/923XXXXXXXXX?text=Hi%20NEXUS%20ESPORTS%2C%20I%20have%20a%20question%20about%20a%20tournament."
          target="_blank"
          rel="noopener noreferrer"
          class="card-dark rounded-2xl p-7 border hover:bg-[#25D366]/5 transition-all duration-300 group block"
          style="border-color: rgba(37,211,102,0.25);"
          aria-label="Chat with NEXUS ESPORTS on WhatsApp (opens in new tab)"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center transition-all group-hover:shadow-[0_0_16px_rgba(37,211,102,0.3)]"
              style="background: rgba(37,211,102,0.15); border: 1px solid rgba(37,211,102,0.3);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-500 group-hover:text-[#25D366] transition-colors mt-1" aria-hidden="true">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
            </svg>
          </div>

          <h3 class="font-tech font-700 text-xl text-white uppercase tracking-wide mb-2 group-hover:text-[#25D366] transition-colors">
            WhatsApp
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            Message our admin directly for registration help, payment issues, or any tournament queries.
          </p>

          <ul class="space-y-1.5 mb-5">
            {[
              'Direct admin contact',
              'Registration support',
              'Payment verification',
              'Quick match queries',
            ].map(item => (
              <li class="flex items-center gap-2 text-gray-400 text-xs font-tech tracking-wide">
                <span class="w-1 h-1 rounded-full bg-[#25D366] flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="w-full text-center py-2.5 rounded text-sm font-tech font-700 tracking-widest uppercase transition-all border" style="border-color: #25D366; color: #25D366;">
            Chat on WhatsApp →
          </div>
        </a>

        <!-- WhatsApp Channel -->
        <a
          href="https://whatsapp.com/channel/nexus-esports"
          target="_blank"
          rel="noopener noreferrer"
          class="card-dark rounded-2xl p-7 border hover:bg-[#25D366]/5 transition-all duration-300 group block"
          style="border-color: rgba(37,211,102,0.2);"
          aria-label="Join NEXUS ESPORTS WhatsApp Channel for live tournament updates (opens in new tab)"
        >
          <div class="flex items-start justify-between mb-5">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center transition-all group-hover:shadow-[0_0_16px_rgba(37,211,102,0.25)]"
              style="background: rgba(37,211,102,0.1); border: 1px solid rgba(37,211,102,0.2);">
              <!-- Broadcast / channel icon -->
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="1.8" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82 19.79 19.79 0 01.5 1.18 2 2 0 012.18.5h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L7.09 7.5a16 16 0 006.41 6.41l.26-.28a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                <path d="M14.5 2a4 4 0 014 4"/>
                <path d="M14.5 2a8 8 0 018 8"/>
              </svg>
            </div>
            <span class="font-tech text-[9px] tracking-widest uppercase px-2 py-1 rounded flex-shrink-0" style="background: rgba(37,211,102,0.15); color: #25D366; border: 1px solid rgba(37,211,102,0.3);">
              ● Live
            </span>
          </div>

          <h3 class="font-tech font-700 text-xl text-white uppercase tracking-wide mb-2 group-hover:text-[#25D366] transition-colors">
            WhatsApp Channel
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-5">
            Subscribe for live broadcast updates — room IDs, schedule changes, match results, and flash tournaments.
          </p>

          <ul class="space-y-1.5 mb-5">
            {[
              'Room ID & password drops',
              'Match schedule alerts',
              'Live results broadcast',
              'Flash tournament alerts',
            ].map(item => (
              <li class="flex items-center gap-2 text-gray-400 text-xs font-tech tracking-wide">
                <span class="w-1 h-1 rounded-full bg-[#25D366] flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>

          <div class="w-full text-center py-2.5 rounded text-sm font-tech font-700 tracking-widest uppercase transition-all border" style="border-color: #25D366; color: #25D366;">
            Join Channel →
          </div>
        </a>

      </div>

      <!-- FAQ Section -->
      <div class="divider-neon mb-10"></div>

      <h2 class="font-tech font-700 text-xl uppercase tracking-widest text-white mb-6 flex items-center gap-3" id="faq-heading">
        <div class="w-1 h-6 bg-neon/50 rounded"></div>
        Frequently Asked Questions
      </h2>

      <div class="space-y-3" role="list" aria-labelledby="faq-heading">
        {faqs.map((faq) => (
          <details class="card-dark rounded-xl border border-white/8 group" role="listitem">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none hover:bg-white/[0.025] rounded-xl transition-colors">
              <span class="font-tech font-700 text-white text-sm tracking-wide pr-4 group-open:text-neon transition-colors">
                {faq.q}
              </span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 text-gray-500 group-open:rotate-180 group-open:text-neon transition-all duration-200" aria-hidden="true">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-400 text-sm leading-relaxed border-t border-white/5 pt-3">
              {faq.a}
            </div>
          </details>
        ))}
      </div>

      <!-- Still need help? -->
      <div class="mt-10 card-dark rounded-xl p-6 border border-neon/15 text-center">
        <p class="text-gray-300 text-sm mb-1">Still have questions?</p>
        <p class="text-gray-400 text-sm mb-4">
          Message us directly on WhatsApp and an admin will respond within a few hours.
        </p>
        <a
          href="https://wa.me/923XXXXXXXXX?text=Hi%20NEXUS%20ESPORTS%2C%20I%20have%20a%20question%20about%20the%20tournament."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-2.5 rounded text-sm font-tech font-700 tracking-widest uppercase transition-all duration-200"
          style="background: rgba(37,211,102,0.12); color: #25D366; border: 1px solid rgba(37,211,102,0.35);"
          aria-label="Chat with NEXUS ESPORTS admin on WhatsApp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat on WhatsApp
        </a>
      </div>

    </div>
  </section>

</Layout>
