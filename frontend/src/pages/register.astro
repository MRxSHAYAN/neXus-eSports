---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Register Squad – NEXUS ESPORTS"
  description="Register your PUBG Mobile squad for NEXUS ESPORTS tournaments. Submit your team name, Captain PUBG ID, and all player UIDs."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="register-heading">
    <div class="max-w-3xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Squad Registration</span>
      <h1 id="register-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Register Your <span class="text-neon">Squad</span>
      </h1>
      <p class="text-gray-400 max-w-md mx-auto">
        Fill out the form below to enter your squad into an upcoming NEXUS ESPORTS tournament.
        All fields are required.
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="form-heading">
    <div class="max-w-2xl mx-auto">

      <form
        id="registration-form"
        class="card-dark rounded-2xl p-6 sm:p-8 space-y-7 border border-white/8"
        novalidate
        aria-label="Squad registration form"
      >
        <h2 id="form-heading" class="sr-only">Squad Registration Form</h2>

        <!-- ── Tournament Selection ── -->
        <fieldset class="space-y-2">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Select Tournament
          </legend>
          <div>
            <label for="tournament" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Tournament <span class="text-red-400">*</span>
            </label>
            <select
              id="tournament"
              name="tournament"
              required
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm appearance-none focus:border-neon transition-colors"
              aria-required="true"
            >
              <option value="" disabled selected>— Choose a tournament —</option>
              <option value="nexus-open-12">NEXUS OPEN CUP #12 (LIVE – Free Entry)</option>
              <option value="weekend-warrior-s3">WEEKEND WARRIOR S3 (Aug 10 – PKR 100/Team)</option>
              <option value="nexus-invitational">NEXUS INVITATIONAL I (Aug 17 – PKR 250/Team)</option>
              <option value="miramar-mayhem">MIRAMAR MAYHEM (Aug 14 – PKR 75/Team)</option>
              <option value="erangel-elite">ERANGEL ELITE CUP (Aug 24 – PKR 150/Team)</option>
              <option value="duo-dominance">DUO DOMINANCE S2 (Aug 21 – PKR 50/Team)</option>
            </select>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Team Info ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Team Information
          </legend>
          <div>
            <label for="team-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Team Name <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="team-name"
              name="team_name"
              placeholder="e.g. NEXUS WOLVES"
              required
              minlength="2"
              maxlength="30"
              autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
              aria-required="true"
            />
            <p class="text-gray-500 text-xs mt-1 font-tech">2–30 characters. Must be unique.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Squad Members ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">
            Squad Roster — All 4 Players
          </legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1 mb-3">
            Enter the In-Game Name and PUBG UID for every player including the Captain.
          </p>

          <!-- Player 1 — Captain -->
          <div class="bg-white/[0.025] rounded-lg p-4 border space-y-3" style="border-color: rgba(0,255,42,0.2);">
            <div class="flex items-center justify-between">
              <p class="font-tech text-xs text-neon tracking-widest uppercase font-700">Player 1 — Captain</p>
              <span class="badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Leader</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player1-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  In-Game Name <span class="text-red-400">*</span>
                </label>
                <input type="text" id="player1-ign" name="player1_ign" placeholder="Captain's IGN"
                  required maxlength="30" autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true" />
              </div>
              <div>
                <label for="player1-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  PUBG UID <span class="text-red-400">*</span>
                </label>
                <input type="text" id="player1-uid" name="player1_uid" placeholder="e.g. 5123456789"
                  required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true" aria-describedby="uid-hint" />
              </div>
            </div>
            <p id="uid-hint" class="text-gray-600 text-[10px] font-tech tracking-wide">UID is a 7–12 digit number found in your PUBG profile.</p>
          </div>

          <!-- Players 2–4 -->
          {[2, 3, 4].map(n => (
            <div class="bg-white/[0.025] rounded-lg p-4 border border-white/8 space-y-3">
              <p class="font-tech text-xs text-gray-400 tracking-widest uppercase font-700">Player {n}</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for={`player${n}-ign`} class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                    In-Game Name <span class="text-red-400">*</span>
                  </label>
                  <input type="text" id={`player${n}-ign`} name={`player${n}_ign`} placeholder={`Player ${n} IGN`}
                    required maxlength="30" autocomplete="off"
                    class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                    aria-required="true" />
                </div>
                <div>
                  <label for={`player${n}-uid`} class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                    PUBG UID <span class="text-red-400">*</span>
                  </label>
                  <input type="text" id={`player${n}-uid`} name={`player${n}_uid`} placeholder={`e.g. 512345678${n}`}
                    required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off"
                    class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                    aria-required="true" />
                </div>
              </div>
            </div>
          ))}
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Contact Info ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Contact Info
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="discord" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
                Discord Username <span class="text-red-400">*</span>
              </label>
              <input type="text" id="discord" name="discord" placeholder="@username#1234"
                required maxlength="50" autocomplete="off"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                aria-required="true" />
            </div>
            <div>
              <label for="whatsapp" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
                WhatsApp Number <span class="text-red-400">*</span>
              </label>
              <input type="tel" id="whatsapp" name="whatsapp" placeholder="+92 3XX XXXXXXX"
                required maxlength="20" autocomplete="tel"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                aria-required="true" />
            </div>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ════════════════════════════════════════════
             ENTRY FEE PAYMENT SECTION (EasyPaisa & JS Bank)
        ════════════════════════════════════════════ -->
        <fieldset id="payment-section" class="space-y-5">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">
            Entry Fee Payment
          </legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1">
            Select your payment method (EasyPaisa or JS Bank) and send the entry fee before submitting.
          </p>

          <!-- Payment Method Tabs (ONLY EasyPaisa & JS Bank) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="group" aria-label="Select payment method">
            <!-- EasyPaisa Option -->
            <label class="payment-tab-label cursor-pointer">
              <input type="radio" name="payment_method" value="easypaisa" class="sr-only peer" required
                aria-label="EasyPaisa" />
              <div class="p-4 rounded-xl border transition-all duration-200 text-center
                border-white/15 bg-white/[0.02]
                peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm
                hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white peer-checked:text-neon">
                  EasyPaisa
                </span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Mobile Account Transfer</span>
              </div>
            </label>

            <!-- JS Bank Option -->
            <label class="payment-tab-label cursor-pointer">
              <input type="radio" name="payment_method" value="jsbank" class="sr-only peer" required
                aria-label="JS Bank" />
              <div class="p-4 rounded-xl border transition-all duration-200 text-center
                border-white/15 bg-white/[0.02]
                peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm
                hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white peer-checked:text-neon">
                  JS Bank
                </span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Bank IBFT / Account Transfer</span>
              </div>
            </label>
          </div>

          <!-- Dynamic Account Display Box — populated from GET /api/bank -->
          <div id="payment-details-box" class="rounded-xl border p-5 space-y-3 hidden" style="background: rgba(0,255,42,0.04); border-color: rgba(0,255,42,0.2);" aria-live="polite">

            <!-- EasyPaisa details -->
            <div id="details-easypaisa" class="payment-method-details hidden">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
                <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">EasyPaisa Account</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                  <p class="font-tech font-700 text-sm text-white" id="title-easypaisa">NEXUS ESPORTS ORG</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Mobile Number</p>
                  <p class="font-tech font-700 text-sm text-white select-all" id="number-easypaisa">0312-9876543</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Entry Fee</p>
                  <p class="font-tech font-700 text-sm text-neon" id="fee-easypaisa">PKR 500 / Squad</p>
                </div>
              </div>
            </div>

            <!-- JS Bank details -->
            <div id="details-jsbank" class="payment-method-details hidden">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
                <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">JS Bank Account</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                  <p class="font-tech font-700 text-sm text-white" id="title-jsbank">NEXUS ENTERTAINMENT ORG</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account / IBAN</p>
                  <p class="font-tech font-700 text-xs text-white select-all break-all" id="number-jsbank">0001-23456789</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Entry Fee</p>
                  <p class="font-tech font-700 text-sm text-neon" id="fee-jsbank">PKR 500 / Squad</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Notice Box -->
          <div id="payment-notice" class="hidden rounded-lg px-4 py-3 border" style="background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.25);" role="note">
            <div class="flex items-start gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r="0.5" fill="#FBBF24"/></svg>
              <p class="font-tech text-xs text-yellow-400 leading-relaxed" id="payment-notice-text">
                Please send the entry fee to the account above before submitting.
                Your squad will be verified within 1 hour.
              </p>
            </div>
          </div>

          <!-- Transaction ID (TID) -->
          <div id="tid-field" class="hidden">
            <label for="transaction-id" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Transaction ID (TID) <span class="text-red-400">*</span>
            </label>
            <input type="text" id="transaction-id" name="transaction_id"
              placeholder="e.g. 12345678901"
              minlength="8" maxlength="20" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
              aria-describedby="tid-hint" />
            <p id="tid-hint" class="text-gray-500 text-xs mt-1 font-tech">Transaction ID or Reference number from your EasyPaisa or JS Bank receipt.</p>
          </div>

          <!-- Payment Proof Upload / Screenshot Link -->
          <div id="proof-field" class="hidden">
            <label for="payment-proof" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Payment Screenshot File / Link <span class="text-red-400">*</span>
            </label>
            <div class="space-y-3">
              <input type="file" id="payment-proof-file" name="paymentProof" accept="image/*"
                class="w-full text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-tech file:font-700 file:bg-neon/15 file:text-neon hover:file:bg-neon/25 cursor-pointer" />
              <p class="text-gray-600 text-[11px] font-tech text-center uppercase tracking-widest">— OR —</p>
              <input type="url" id="payment-proof-url" name="payment_proof_url"
                placeholder="https://imgur.com/your-screenshot or Google Drive public link"
                maxlength="500" autocomplete="off"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                aria-describedby="proof-hint" />
            </div>
            <p id="proof-hint" class="text-gray-500 text-xs mt-1 font-tech">
              Upload screenshot image directly or paste public link from Imgur / Google Drive.
            </p>
          </div>

        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Submit ── -->
        <div>
          <button
            type="submit"
            id="submit-btn"
            class="btn-neon w-full py-4 rounded-lg text-sm tracking-[.15em] shadow-neon font-tech font-700 uppercase disabled:opacity-50 disabled:cursor-not-allowed"
            aria-label="Submit squad registration"
          >
            Submit Registration
          </button>
          <p class="text-center text-gray-600 text-xs font-tech mt-3 tracking-wide">
            Your registration will automatically log to Google Sheets &amp; confirm via Discord.
          </p>
        </div>

        <!-- Success Banner -->
        <div id="success-banner" class="hidden rounded-xl border px-6 py-6 text-center space-y-2" style="background: rgba(0,255,42,0.08); border-color: rgba(0,255,42,0.3);" role="status" aria-live="polite">
          <div class="w-12 h-12 rounded-full mx-auto flex items-center justify-center font-tech font-700 text-xl mb-2" style="background: var(--neon); color: #05070A;">✓</div>
          <h3 class="font-tech font-700 text-neon text-lg tracking-widest uppercase">Squad Registered Successfully!</h3>
          <p class="text-gray-300 text-xs font-tech leading-relaxed max-w-md mx-auto" id="success-message">
            Your squad details have been automatically logged directly into our live Google Sheet spreadsheet. Our admin team will verify your payment screenshot shortly!
          </p>
        </div>

      </form>
    </div>
  </section>

</Layout>

<script>
  const API_BASE = 'http://localhost:5000/api';

  const feesMap: Record<string, number> = {
    'nexus-open-12':       0,
    'weekend-warrior-s3':  100,
    'nexus-invitational':  250,
    'miramar-mayhem':      75,
    'erangel-elite':       150,
    'duo-dominance':       50,
  };

  const detailsBox      = document.getElementById('payment-details-box') as HTMLElement;
  const noticeBox       = document.getElementById('payment-notice') as HTMLElement;
  const noticeText      = document.getElementById('payment-notice-text') as HTMLElement;
  const tidField        = document.getElementById('tid-field') as HTMLElement;
  const proofField      = document.getElementById('proof-field') as HTMLElement;
  const tidInput        = document.getElementById('transaction-id') as HTMLInputElement;
  const proofFileInput  = document.getElementById('payment-proof-file') as HTMLInputElement;
  const proofUrlInput   = document.getElementById('payment-proof-url') as HTMLInputElement;
  const tournamentSel   = document.getElementById('tournament') as HTMLSelectElement;

  // Dynamically load EasyPaisa & JS Bank details from backend API
  async function fetchLiveBankDetails() {
    try {
      const res = await fetch(`${API_BASE}/bank`);
      if (!res.ok) return;
      const result = await res.json();
      if (result.success && result.data) {
        const d = result.data;
        if (d.easypaisa) {
          const tEP = document.getElementById('title-easypaisa');
          const nEP = document.getElementById('number-easypaisa');
          if (tEP) tEP.textContent = d.easypaisa.accountName || d.easypaisa.title || 'NEXUS ESPORTS ORG';
          if (nEP) nEP.textContent = d.easypaisa.accountNumber || d.easypaisa.number || '0312-9876543';
        }
        if (d.jsbank || d.sadapay || d.bank) {
          const jsb = d.jsbank || d.sadapay || d.bank;
          const tJSB = document.getElementById('title-jsbank');
          const nJSB = document.getElementById('number-jsbank');
          if (tJSB) tJSB.textContent = jsb.accountName || jsb.title || 'NEXUS ENTERTAINMENT ORG';
          if (nJSB) nJSB.textContent = jsb.accountNumber || jsb.ibanTitle || '0001-23456789';
        }
      }
    } catch (err) {
      console.warn('⚠️ [Register Page] Backend API offline, displaying fallback account numbers.');
    }
  }

  function getEntryFeeLabel(val: string): string {
    const fee = feesMap[val];
    if (fee === undefined || fee === 0) return 'Free Entry';
    return `PKR ${fee} / Squad`;
  }

  function updatePaymentUI() {
    const tVal = tournamentSel.value;
    const isFree = !tVal || feesMap[tVal] === 0;

    if (isFree) {
      detailsBox.classList.add('hidden');
      noticeBox.classList.add('hidden');
      tidField.classList.add('hidden');
      proofField.classList.add('hidden');
      tidInput.required = false;
      return;
    }

    const selected = (document.querySelector('input[name="payment_method"]:checked') as HTMLInputElement)?.value;

    ['easypaisa', 'jsbank'].forEach(m => {
      const el = document.getElementById(`fee-${m}`);
      if (el) el.textContent = getEntryFeeLabel(tVal);
    });

    if (selected) {
      detailsBox.classList.remove('hidden');
      document.querySelectorAll<HTMLElement>('.payment-method-details').forEach(d => d.classList.add('hidden'));
      const panel = document.getElementById(`details-${selected}`);
      if (panel) panel.classList.remove('hidden');

      noticeBox.classList.remove('hidden');
      noticeText.textContent = `Please send ${getEntryFeeLabel(tVal)} to the ${selected === 'easypaisa' ? 'EasyPaisa' : 'JS Bank'} account above before submitting. Your squad will be verified within 1 hour.`;

      tidField.classList.remove('hidden');
      proofField.classList.remove('hidden');
      tidInput.required = true;
    } else {
      detailsBox.classList.add('hidden');
      noticeBox.classList.add('hidden');
      tidField.classList.add('hidden');
      proofField.classList.add('hidden');
      tidInput.required = false;
    }
  }

  tournamentSel.addEventListener('change', updatePaymentUI);
  document.querySelectorAll('input[name="payment_method"]').forEach(r =>
    r.addEventListener('change', updatePaymentUI)
  );

  // Form submission handler
  const form          = document.getElementById('registration-form') as HTMLFormElement;
  const submitBtn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const successBanner = document.getElementById('success-banner') as HTMLElement;
  const successMsg    = document.getElementById('success-message') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const tVal = tournamentSel.value;
    const isFree = !tVal || feesMap[tVal] === 0;
    const selectedMethod = (document.querySelector('input[name="payment_method"]:checked') as HTMLInputElement)?.value;

    if (!tVal) { tournamentSel.focus(); return; }
    if (!isFree && !selectedMethod) {
      alert('Please select either EasyPaisa or JS Bank as your payment method.');
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Registering Squad...';

    const formData = new FormData(form);
    const tournamentName = tournamentSel.options[tournamentSel.selectedIndex]?.text?.split(' (')[0] ?? tVal;
    const squadName = (formData.get('team_name') as string).toUpperCase();
    const discordName = formData.get('discord') as string;
    const whatsappNum = formData.get('whatsapp') as string;

    const players = [1, 2, 3, 4].map(n =>
      `${formData.get(`player${n}_ign`)}|${formData.get(`player${n}_uid`)}`
    );

    // Build payload for backend API
    const apiPayload = new FormData();
    apiPayload.append('name', squadName);
    apiPayload.append('tournament', tournamentName);
    apiPayload.append('captain', discordName);
    apiPayload.append('discord', discordName);
    apiPayload.append('whatsapp', whatsappNum);
    apiPayload.append('paymentMethod', selectedMethod || 'free');
    apiPayload.append('transactionId', (formData.get('transaction_id') as string) || 'FREE-ENTRY');
    apiPayload.append('entryFee', getEntryFeeLabel(tVal));
    apiPayload.append('players', JSON.stringify(players));

    if (proofFileInput.files && proofFileInput.files[0]) {
      apiPayload.append('paymentProof', proofFileInput.files[0]);
    } else if (proofUrlInput.value) {
      apiPayload.append('paymentProof', proofUrlInput.value);
    }

    try {
      const res = await fetch(`${API_BASE}/teams/register`, {
        method: 'POST',
        body: apiPayload
      });

      const result = await res.json();

      if (res.ok && result.success) {
        if (successMsg) {
          successMsg.textContent = result.googleSheetSynced
            ? `Squad "${squadName}" was registered and automatically logged to Google Sheets! Status: ${isFree ? 'Approved' : 'Pending Admin Verification'}.`
            : `Squad "${squadName}" registered successfully! Status: ${isFree ? 'Approved' : 'Pending Admin Verification'}.`;
        }
      } else {
        throw new Error(result.message || 'Registration failed');
      }
    } catch (err: any) {
      console.warn('⚠️ [Register Page] Backend API offline, saving squad locally:', err.message);

      const registration = {
        id: `NEXUS-${Date.now().toString().slice(-6)}`,
        name: squadName,
        tournament: tournamentName,
        captain: discordName,
        discord: discordName,
        whatsapp: whatsappNum,
        players,
        date: new Date().toLocaleDateString('en-PK', { month: 'short', day: 'numeric', year: 'numeric' }),
        status: isFree ? 'approved' : 'pending',
        paymentMethod: selectedMethod || 'free',
        transactionId: (formData.get('transaction_id') as string) || 'FREE-ENTRY',
        paymentProof: proofUrlInput.value || '',
        entryFee: getEntryFeeLabel(tVal),
      };

      const STORAGE_KEY = 'nexus_admin_teams';
      let teams: any[] = [];
      try { teams = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]') || []; } catch { teams = []; }
      teams.unshift(registration);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(teams));

      if (successMsg) {
        successMsg.textContent = `Squad "${squadName}" registered in local fallback mode! Status: ${isFree ? 'Approved' : 'Pending Admin Verification'}.`;
      }
    } finally {
      form.classList.add('hidden');
      successBanner.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Init on mount
  document.addEventListener('DOMContentLoaded', () => {
    fetchLiveBankDetails();
    updatePaymentUI();
  });
</script>
