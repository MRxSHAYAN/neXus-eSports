---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Register Squad – NEXUS ESPORTS"
  description="Register your PUBG Mobile squad for NEXUS ESPORTS tournaments. Submit your team name, player UIDs, and payment proof."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="register-heading">
    <div class="max-w-3xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Squad Registration</span>
      <h1 id="register-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Register Your <span class="text-neon">Squad</span>
      </h1>
      <p class="text-gray-400 max-w-md mx-auto">
        Fill out the form below to enter your squad into an upcoming NEXUS ESPORTS tournament.
        All fields are required.
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="form-heading">
    <div class="max-w-2xl mx-auto">

      <form
        id="registration-form"
        class="card-dark rounded-2xl p-6 sm:p-8 space-y-7 border border-white/8"
        novalidate
        aria-label="Squad registration form"
      >
        <h2 id="form-heading" class="sr-only">Squad Registration Form</h2>

        <!-- ── Tournament Selection ── -->
        <fieldset class="space-y-2">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Select Tournament
          </legend>
          <div>
            <label for="tournament" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Tournament <span class="text-red-400">*</span>
            </label>
            <select
              id="tournament"
              name="tournament"
              required
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm appearance-none focus:border-neon transition-colors"
              aria-required="true"
            >
              <option value="" disabled selected>— Loading tournaments... —</option>
            </select>
            <p id="tournament-load-error" class="hidden text-yellow-400 text-xs mt-1 font-tech">Could not load live tournaments. Showing cached list.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Team Info ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Team Information
          </legend>
          <div>
            <label for="team-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Team / Squad Name <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="team-name"
              name="team_name"
              placeholder="e.g. NEXUS WOLVES"
              required
              minlength="2"
              maxlength="30"
              autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
              aria-required="true"
            />
            <p class="text-gray-500 text-xs mt-1 font-tech">2–30 characters. Must be unique.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Squad Members ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">
            Squad Roster — All 4 Players
          </legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1 mb-3">
            Enter the In-Game Name and PUBG UID for every player including the Captain.
          </p>

          <!-- Player 1 — Captain -->
          <div class="bg-white/[0.025] rounded-lg p-4 border space-y-3" style="border-color: rgba(0,255,42,0.2);">
            <div class="flex items-center justify-between">
              <p class="font-tech text-xs text-neon tracking-widest uppercase font-700">Player 1 — Captain</p>
              <span class="badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Leader</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player1-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  In-Game Name <span class="text-red-400">*</span>
                </label>
                <input type="text" id="player1-ign" name="player1_ign" placeholder="Captain's IGN"
                  required maxlength="30" autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true" />
              </div>
              <div>
                <label for="player1-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  PUBG UID <span class="text-red-400">*</span>
                </label>
                <input type="text" id="player1-uid" name="player1_uid" placeholder="e.g. 5123456789"
                  required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true" aria-describedby="uid-hint" />
              </div>
            </div>
            <p id="uid-hint" class="text-gray-600 text-[10px] font-tech tracking-wide">UID is a 7–12 digit number found in your PUBG profile.</p>
          </div>

          <!-- Players 2–4 (rendered identically) -->
          <div class="bg-white/[0.025] rounded-lg p-4 border border-white/8 space-y-3">
            <p class="font-tech text-xs text-gray-400 tracking-widest uppercase font-700">Player 2</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player2-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">In-Game Name <span class="text-red-400">*</span></label>
                <input type="text" id="player2-ign" name="player2_ign" placeholder="Player 2 IGN" required maxlength="30" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
              <div>
                <label for="player2-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">PUBG UID <span class="text-red-400">*</span></label>
                <input type="text" id="player2-uid" name="player2_uid" placeholder="e.g. 5123456790" required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
            </div>
          </div>

          <div class="bg-white/[0.025] rounded-lg p-4 border border-white/8 space-y-3">
            <p class="font-tech text-xs text-gray-400 tracking-widest uppercase font-700">Player 3</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player3-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">In-Game Name <span class="text-red-400">*</span></label>
                <input type="text" id="player3-ign" name="player3_ign" placeholder="Player 3 IGN" required maxlength="30" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
              <div>
                <label for="player3-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">PUBG UID <span class="text-red-400">*</span></label>
                <input type="text" id="player3-uid" name="player3_uid" placeholder="e.g. 5123456791" required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
            </div>
          </div>

          <div class="bg-white/[0.025] rounded-lg p-4 border border-white/8 space-y-3">
            <p class="font-tech text-xs text-gray-400 tracking-widest uppercase font-700">Player 4</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player4-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">In-Game Name <span class="text-red-400">*</span></label>
                <input type="text" id="player4-ign" name="player4_ign" placeholder="Player 4 IGN" required maxlength="30" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
              <div>
                <label for="player4-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">PUBG UID <span class="text-red-400">*</span></label>
                <input type="text" id="player4-uid" name="player4_uid" placeholder="e.g. 5123456792" required pattern="[0-9]{7,12}" maxlength="12" inputmode="numeric" autocomplete="off" class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" aria-required="true" />
              </div>
            </div>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Contact Info ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Captain Contact Info
          </legend>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="captain-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
                Captain Name <span class="text-red-400">*</span>
              </label>
              <input type="text" id="captain-name" name="captain_name" placeholder="Captain's real/IGN"
                required maxlength="50" autocomplete="off"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                aria-required="true" />
            </div>
            <div>
              <label for="whatsapp" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
                WhatsApp Number <span class="text-red-400">*</span>
              </label>
              <input type="tel" id="whatsapp" name="whatsapp" placeholder="+92 3XX XXXXXXX"
                required maxlength="20" autocomplete="tel"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                aria-required="true" />
            </div>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Payment Section ── -->
        <fieldset id="payment-section" class="space-y-5">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">
            Entry Fee Payment
          </legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1">
            Select your payment method and send the entry fee before submitting.
          </p>

          <!-- Payment Method Tabs — JazzCash / EasyPaisa / SadaPay -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" role="group" aria-label="Select payment method">
            <label class="payment-tab-label cursor-pointer">
              <input type="radio" name="payment_method" value="JazzCash" class="sr-only peer" aria-label="JazzCash" />
              <div class="p-4 rounded-xl border transition-all duration-200 text-center border-white/15 bg-white/[0.02] peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">JazzCash</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Mobile Wallet</span>
              </div>
            </label>
            <label class="payment-tab-label cursor-pointer">
              <input type="radio" name="payment_method" value="EasyPaisa" class="sr-only peer" aria-label="EasyPaisa" />
              <div class="p-4 rounded-xl border transition-all duration-200 text-center border-white/15 bg-white/[0.02] peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">EasyPaisa</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Mobile Account</span>
              </div>
            </label>
            <label class="payment-tab-label cursor-pointer">
              <input type="radio" name="payment_method" value="SadaPay" class="sr-only peer" aria-label="SadaPay" />
              <div class="p-4 rounded-xl border transition-all duration-200 text-center border-white/15 bg-white/[0.02] peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">SadaPay</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">IBFT Transfer</span>
              </div>
            </label>
          </div>

          <!-- Dynamic Account Details Box -->
          <div id="payment-details-box" class="rounded-xl border p-5 space-y-3 hidden" style="background: rgba(0,255,42,0.04); border-color: rgba(0,255,42,0.2);" aria-live="polite">
            <div id="details-JazzCash" class="payment-method-details hidden">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
                <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">JazzCash Account</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                  <p class="font-tech font-700 text-sm text-white" id="title-JazzCash">NEXUS ESPORTS</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Mobile Number</p>
                  <p class="font-tech font-700 text-sm text-white select-all" id="number-JazzCash">0300-0000000</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Entry Fee</p>
                  <p class="font-tech font-700 text-sm text-neon" id="fee-display-JazzCash">PKR 0</p>
                </div>
              </div>
            </div>
            <div id="details-EasyPaisa" class="payment-method-details hidden">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
                <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">EasyPaisa Account</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                  <p class="font-tech font-700 text-sm text-white" id="title-EasyPaisa">NEXUS ESPORTS</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Mobile Number</p>
                  <p class="font-tech font-700 text-sm text-white select-all" id="number-EasyPaisa">0333-0000000</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Entry Fee</p>
                  <p class="font-tech font-700 text-sm text-neon" id="fee-display-EasyPaisa">PKR 0</p>
                </div>
              </div>
            </div>
            <div id="details-SadaPay" class="payment-method-details hidden">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
                <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">SadaPay Account</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                  <p class="font-tech font-700 text-sm text-white" id="title-SadaPay">NEXUS ESPORTS</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">IBAN / Number</p>
                  <p class="font-tech font-700 text-xs text-white select-all break-all" id="number-SadaPay">PK00SADA0000000000000000</p>
                </div>
                <div class="bg-white/5 rounded-lg px-3 py-2.5">
                  <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Entry Fee</p>
                  <p class="font-tech font-700 text-sm text-neon" id="fee-display-SadaPay">PKR 0</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Notice -->
          <div id="payment-notice" class="hidden rounded-lg px-4 py-3 border" style="background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.25);" role="note">
            <div class="flex items-start gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><circle cx="12" cy="16" r="0.5" fill="#FBBF24"/></svg>
              <p class="font-tech text-xs text-yellow-400 leading-relaxed" id="payment-notice-text">
                Please send the entry fee to the account above before submitting. Your squad will be verified within 1 hour.
              </p>
            </div>
          </div>

          <!-- TID -->
          <div id="tid-field" class="hidden">
            <label for="transaction-id" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Transaction ID (TID) <span class="text-red-400">*</span>
            </label>
            <input type="text" id="transaction-id" name="transaction_id"
              placeholder="e.g. 12345678901"
              minlength="8" maxlength="24" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
            <p class="text-gray-500 text-xs mt-1 font-tech">Transaction / Reference number from your JazzCash, EasyPaisa, or SadaPay receipt.</p>
          </div>

          <!-- Payment Proof -->
          <div id="proof-field" class="hidden">
            <label for="payment-proof-file" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Payment Screenshot <span class="text-red-400">*</span>
            </label>
            <div class="space-y-3">
              <input type="file" id="payment-proof-file" name="paymentProof" accept="image/*"
                class="w-full text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-tech file:font-700 file:bg-neon/15 file:text-neon hover:file:bg-neon/25 cursor-pointer" />
              <p class="text-gray-600 text-[11px] font-tech text-center uppercase tracking-widest">— OR paste link —</p>
              <input type="url" id="payment-proof-url" name="payment_proof_url"
                placeholder="https://imgur.com/your-screenshot"
                maxlength="500" autocomplete="off"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
            </div>
            <p class="text-gray-500 text-xs mt-1 font-tech">Upload screenshot or paste Imgur / Google Drive public link.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Submit ── -->
        <div>
          <button
            type="submit"
            id="submit-btn"
            class="btn-neon w-full py-4 rounded-lg text-sm tracking-[.15em] shadow-neon font-tech font-700 uppercase disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Submit Registration
          </button>
          <p class="text-center text-gray-600 text-xs font-tech mt-3 tracking-wide">
            Registration will be logged and confirmed via WhatsApp within 1 hour.
          </p>
        </div>

        <!-- Success Modal Overlay -->
        <div id="success-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(8px);">
          <div class="card-dark rounded-2xl border p-8 max-w-md w-full text-center space-y-4" style="border-color: rgba(0,255,42,0.35); box-shadow: 0 0 40px rgba(0,255,42,0.1);">
            <div class="w-16 h-16 rounded-full mx-auto flex items-center justify-center font-tech font-700 text-2xl mb-2" style="background: var(--neon); color: #05070A;">✓</div>
            <h3 class="font-tech font-700 text-neon text-xl tracking-widest uppercase">Squad Registered!</h3>
            <p class="text-gray-300 text-sm font-tech leading-relaxed" id="success-message">
              Your squad has been registered successfully. Our admin will verify your payment and confirm within 1 hour.
            </p>
            <a
              href="https://whatsapp.com/channel/nexus-esports"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2.5 w-full py-3.5 rounded-lg font-tech font-700 text-sm tracking-widest uppercase transition-all duration-200"
              style="background: rgba(37,211,102,0.15); color: #25D366; border: 1px solid rgba(37,211,102,0.4);"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.82 19.79 19.79 0 01.5 1.18 2 2 0 012.18.5h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L7.09 7.5a16 16 0 006.41 6.41l.26-.28a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
              Join WhatsApp Channel for Updates
            </a>
            <button id="close-success-modal" class="btn-outline-neon w-full py-2.5 rounded-lg text-sm tracking-widest">
              Register Another Squad
            </button>
          </div>
        </div>

      </form>
    </div>
  </section>

</Layout>

<script>
  const API_BASE = 'http://localhost:5000/api';

  // Fallback tournaments if API is offline
  const fallbackTournaments = [
    { id: 'nexus-open-12',     title: 'NEXUS OPEN CUP #12',    entryFee: 'Free Entry',      status: 'Active' },
    { id: 'weekend-warrior-s3',title: 'WEEKEND WARRIOR S3',    entryFee: 'PKR 100 / Team',  status: 'Active' },
    { id: 'nexus-invitational', title: 'NEXUS INVITATIONAL I',  entryFee: 'PKR 250 / Team',  status: 'Active' },
    { id: 'miramar-mayhem',    title: 'MIRAMAR MAYHEM',        entryFee: 'PKR 75 / Team',   status: 'Active' },
    { id: 'erangel-elite',     title: 'ERANGEL ELITE CUP',     entryFee: 'PKR 150 / Team',  status: 'Active' },
  ];

  // In-memory bank details (updated from API)
  let bankDetails: Record<string, any> = {
    JazzCash:  { title: 'NEXUS ESPORTS', number: '0300-0000000' },
    EasyPaisa: { title: 'NEXUS ESPORTS', number: '0333-0000000' },
    SadaPay:   { title: 'NEXUS ESPORTS', number: 'PK00SADA0000000000000000' },
  };

  let loadedTournaments: any[] = [];

  // ── Load active tournaments from API ─────────────────────────
  async function loadTournaments() {
    const sel = document.getElementById('tournament') as HTMLSelectElement;
    const errEl = document.getElementById('tournament-load-error') as HTMLElement;
    try {
      const res = await fetch(`${API_BASE}/tournaments?status=Active`);
      const data = await res.json();
      if (data.success && Array.isArray(data.data) && data.data.length > 0) {
        loadedTournaments = data.data.filter((t: any) => t.status === 'Active' || t.status === 'live' || t.status === 'upcoming' || t.status === 'Open');
      } else {
        throw new Error('No tournaments');
      }
    } catch {
      loadedTournaments = fallbackTournaments;
      errEl?.classList.remove('hidden');
    }
    sel.innerHTML = '<option value="" disabled selected>— Choose a tournament —</option>';
    loadedTournaments.forEach((t: any) => {
      const opt = document.createElement('option');
      opt.value = t.id || t._id;
      opt.textContent = `${t.title} (${t.entryFee || 'Free Entry'})`;
      opt.dataset.fee = t.entryFee || 'Free Entry';
      sel.appendChild(opt);
    });
  }

  // ── Load bank details from API ────────────────────────────────
  async function loadBankDetails() {
    try {
      const res = await fetch(`${API_BASE}/bank`);
      const data = await res.json();
      if (data.success && data.data) {
        const d = data.data;
        const jz = d.jazzcash || d.JazzCash || {};
        const ep = d.easypaisa || d.EasyPaisa || {};
        const sp = d.sadapay || d.SadaPay || {};
        bankDetails = {
          JazzCash:  { title: jz.accountName || jz.jazzcashTitle || 'NEXUS ESPORTS', number: jz.accountNumber || jz.jazzcashNumber || '0300-0000000' },
          EasyPaisa: { title: ep.accountName || ep.easypaisaTitle || 'NEXUS ESPORTS', number: ep.accountNumber || ep.easypaisaNumber || '0333-0000000' },
          SadaPay:   { title: sp.accountName || sp.sadapayTitle || 'NEXUS ESPORTS', number: sp.accountNumber || sp.ibanTitle || sp.sadapayNumber || 'PK00SADA0000000000000000' },
        };
        // Update DOM
        ['JazzCash','EasyPaisa','SadaPay'].forEach(m => {
          const t = document.getElementById(`title-${m}`);
          const n = document.getElementById(`number-${m}`);
          if (t) t.textContent = bankDetails[m].title;
          if (n) n.textContent = bankDetails[m].number;
        });
      }
    } catch { /* keep defaults */ }
  }

  function getFeeFromSelection(): string {
    const sel = document.getElementById('tournament') as HTMLSelectElement;
    if (!sel.value) return 'Free Entry';
    const opt = sel.options[sel.selectedIndex];
    return opt?.dataset?.fee || 'Free Entry';
  }

  function isFree(feeStr: string): boolean {
    return !feeStr || feeStr.toLowerCase() === 'free entry' || feeStr.toLowerCase().includes('free');
  }

  function updatePaymentUI() {
    const fee = getFeeFromSelection();
    const free = isFree(fee);
    const selected = (document.querySelector('input[name="payment_method"]:checked') as HTMLInputElement)?.value;
    const detailsBox = document.getElementById('payment-details-box') as HTMLElement;
    const noticeBox  = document.getElementById('payment-notice') as HTMLElement;
    const noticeText = document.getElementById('payment-notice-text') as HTMLElement;
    const tidField   = document.getElementById('tid-field') as HTMLElement;
    const proofField = document.getElementById('proof-field') as HTMLElement;
    const tidInput   = document.getElementById('transaction-id') as HTMLInputElement;

    // Update fee labels
    ['JazzCash','EasyPaisa','SadaPay'].forEach(m => {
      const el = document.getElementById(`fee-display-${m}`);
      if (el) el.textContent = free ? 'Free Entry' : fee;
    });

    if (free) {
      detailsBox.classList.add('hidden');
      noticeBox.classList.add('hidden');
      tidField.classList.add('hidden');
      proofField.classList.add('hidden');
      tidInput.required = false;
      return;
    }

    if (selected) {
      detailsBox.classList.remove('hidden');
      document.querySelectorAll<HTMLElement>('.payment-method-details').forEach(d => d.classList.add('hidden'));
      document.getElementById(`details-${selected}`)?.classList.remove('hidden');
      noticeBox.classList.remove('hidden');
      noticeText.textContent = `Please send ${fee} to the ${selected} account above before submitting. Your squad will be verified within 1 hour.`;
      tidField.classList.remove('hidden');
      proofField.classList.remove('hidden');
      tidInput.required = true;
    } else {
      detailsBox.classList.add('hidden');
      noticeBox.classList.add('hidden');
      tidField.classList.add('hidden');
      proofField.classList.add('hidden');
      tidInput.required = false;
    }
  }

  document.getElementById('tournament')?.addEventListener('change', updatePaymentUI);
  document.querySelectorAll('input[name="payment_method"]').forEach(r =>
    r.addEventListener('change', updatePaymentUI)
  );

  // ── Form submission ───────────────────────────────────────────
  const form          = document.getElementById('registration-form') as HTMLFormElement;
  const submitBtn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const successModal  = document.getElementById('success-modal') as HTMLElement;
  const successMsg    = document.getElementById('success-message') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const tSel = document.getElementById('tournament') as HTMLSelectElement;
    const fee = getFeeFromSelection();
    const free = isFree(fee);
    const selectedMethod = (document.querySelector('input[name="payment_method"]:checked') as HTMLInputElement)?.value;

    if (!tSel.value) { tSel.focus(); return; }
    if (!free && !selectedMethod) {
      alert('Please select a payment method: JazzCash, EasyPaisa, or SadaPay.');
      return;
    }
    if (!form.checkValidity()) { form.reportValidity(); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Registering...';

    const formData = new FormData(form);
    const squadName = ((formData.get('team_name') as string) || '').toUpperCase().trim();
    const captainName = formData.get('captain_name') as string;
    const whatsappNum = formData.get('whatsapp') as string;
    const tid = formData.get('transaction_id') as string || 'FREE-ENTRY';
    const tName = tSel.options[tSel.selectedIndex]?.text?.split(' (')[0] ?? tSel.value;
    const proofFileInput  = document.getElementById('payment-proof-file') as HTMLInputElement;
    const proofUrlInput   = document.getElementById('payment-proof-url') as HTMLInputElement;
    const players = [1,2,3,4].map(n =>
      `${formData.get(`player${n}_ign`)}|${formData.get(`player${n}_uid`)}`
    );

    const apiPayload = new FormData();
    apiPayload.append('name', squadName);
    apiPayload.append('tournament', tName);
    apiPayload.append('captain', captainName);
    apiPayload.append('whatsapp', whatsappNum);
    apiPayload.append('paymentMethod', selectedMethod || 'free');
    apiPayload.append('transactionId', tid);
    apiPayload.append('entryFee', fee);
    apiPayload.append('players', JSON.stringify(players));
    if (proofFileInput.files?.[0]) apiPayload.append('paymentProof', proofFileInput.files[0]);
    else if (proofUrlInput.value)   apiPayload.append('paymentProof', proofUrlInput.value);

    try {
      const res = await fetch(`${API_BASE}/teams/register`, { method: 'POST', body: apiPayload });
      const result = await res.json();
      if (!res.ok || !result.success) throw new Error(result.message || 'Registration failed');
      successMsg.textContent = `Squad "${squadName}" registered! Status: ${free ? 'Approved' : 'Pending payment verification'}. Admin will confirm via WhatsApp.`;
    } catch (err: any) {
      // Fallback local
      const reg = {
        id: `NEXUS-${Date.now().toString().slice(-6)}`,
        name: squadName, tournament: tName, captain: captainName, whatsapp: whatsappNum,
        players, date: new Date().toLocaleDateString('en-PK',{month:'short',day:'numeric',year:'numeric'}),
        status: free ? 'approved' : 'pending', paymentMethod: selectedMethod || 'free',
        transactionId: tid, entryFee: fee,
      };
      try {
        const existing = JSON.parse(localStorage.getItem('nexus_admin_teams') || '[]');
        existing.unshift(reg);
        localStorage.setItem('nexus_admin_teams', JSON.stringify(existing));
      } catch {}
      successMsg.textContent = `Squad "${squadName}" saved locally! Status: ${free ? 'Approved' : 'Pending'}. Start the backend server to sync to MongoDB.`;
    } finally {
      form.classList.add('hidden');
      successModal.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Registration';
    }
  });

  document.getElementById('close-success-modal')?.addEventListener('click', () => {
    successModal.classList.add('hidden');
    form.classList.remove('hidden');
    form.reset();
    updatePaymentUI();
  });

  document.addEventListener('DOMContentLoaded', () => {
    loadTournaments();
    loadBankDetails();
    updatePaymentUI();
  });
</script>
