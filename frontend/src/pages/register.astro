---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Register Squad – NEXUS ESPORTS"
  description="Register your PUBG Mobile squad for NEXUS ESPORTS tournaments. Submit your team name, Captain PUBG ID, and all player UIDs."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="register-heading">
    <div class="max-w-3xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Squad Registration</span>
      <h1 id="register-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Register Your <span class="text-neon">Squad</span>
      </h1>
      <p class="text-gray-400 max-w-md mx-auto">
        Fill out the form below to enter your squad into an upcoming NEXUS ESPORTS tournament.
        All fields are required.
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="form-heading">
    <div class="max-w-2xl mx-auto">

      <form
        id="registration-form"
        class="card-dark rounded-2xl p-6 sm:p-8 space-y-7 border border-white/8"
        novalidate
        aria-label="Squad registration form"
      >
        <h2 id="form-heading" class="sr-only">Squad Registration Form</h2>

        <!-- ── Tournament Selection ── -->
        <fieldset class="space-y-2">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Select Tournament
          </legend>
          <div>
            <label for="tournament" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Tournament <span class="text-red-400">*</span>
            </label>
            <select
              id="tournament"
              name="tournament"
              required
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm appearance-none focus:border-neon transition-colors"
              aria-required="true"
            >
              <option value="" disabled selected>— Choose a tournament —</option>
              <option value="nexus-open-12">NEXUS OPEN CUP #12 (LIVE – Free Entry)</option>
              <option value="weekend-warrior-s3">WEEKEND WARRIOR S3 (Aug 10 – PKR 100/Team)</option>
              <option value="nexus-invitational">NEXUS INVITATIONAL I (Aug 17 – PKR 250/Team)</option>
              <option value="miramar-mayhem">MIRAMAR MAYHEM (Aug 14 – PKR 75/Team)</option>
              <option value="erangel-elite">ERANGEL ELITE CUP (Aug 24 – PKR 150/Team)</option>
              <option value="duo-dominance">DUO DOMINANCE S2 (Aug 21 – PKR 50/Team)</option>
            </select>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Team Info ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Team Information
          </legend>

          <div>
            <label for="team-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Team Name <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="team-name"
              name="team_name"
              placeholder="e.g. NEXUS WOLVES"
              required
              minlength="2"
              maxlength="30"
              autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
              aria-required="true"
            />
            <p class="text-gray-500 text-xs mt-1 font-tech">2–30 characters. Must be unique.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Squad Members (Player 1 = Captain + Players 2–4) ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">
            Squad Roster — All 4 Players
          </legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1 mb-3">
            Enter the In-Game Name and PUBG UID for every player including the Captain.
          </p>

          <!-- Player 1 — Captain -->
          <div class="bg-white/[0.025] rounded-lg p-4 border space-y-3" style="border-color: rgba(0,255,42,0.2);">
            <div class="flex items-center justify-between">
              <p class="font-tech text-xs text-neon tracking-widest uppercase font-700">Player 1 — Captain</p>
              <span class="badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Leader</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="player1-ign" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  In-Game Name <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="player1-ign"
                  name="player1_ign"
                  placeholder="Captain's IGN"
                  required
                  maxlength="30"
                  autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true"
                />
              </div>
              <div>
                <label for="player1-uid" class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                  PUBG UID <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="player1-uid"
                  name="player1_uid"
                  placeholder="e.g. 5123456789"
                  required
                  pattern="[0-9]{7,12}"
                  maxlength="12"
                  inputmode="numeric"
                  autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                  aria-required="true"
                  aria-describedby="uid-hint"
                />
              </div>
            </div>
            <p id="uid-hint" class="text-gray-600 text-[10px] font-tech tracking-wide">UID is a 7–12 digit number found in your PUBG profile.</p>
          </div>

          <!-- Players 2–4 -->
          {[2, 3, 4].map(n => (
            <div class="bg-white/[0.025] rounded-lg p-4 border border-white/8 space-y-3">
              <p class="font-tech text-xs text-gray-400 tracking-widest uppercase font-700">Player {n}</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for={`player${n}-ign`} class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                    In-Game Name <span class="text-red-400">*</span>
                  </label>
                  <input
                    type="text"
                    id={`player${n}-ign`}
                    name={`player${n}_ign`}
                    placeholder={`Player ${n} IGN`}
                    required
                    maxlength="30"
                    autocomplete="off"
                    class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                    aria-required="true"
                  />
                </div>
                <div>
                  <label for={`player${n}-uid`} class="block text-xs text-gray-400 mb-1.5 font-tech tracking-wide">
                    PUBG UID <span class="text-red-400">*</span>
                  </label>
                  <input
                    type="text"
                    id={`player${n}-uid`}
                    name={`player${n}_uid`}
                    placeholder={`e.g. 512345678${n}`}
                    required
                    pattern="[0-9]{7,12}"
                    maxlength="12"
                    inputmode="numeric"
                    autocomplete="off"
                    class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-3 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
                    aria-required="true"
                  />
                </div>
              </div>
            </div>
          ))}
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Contact ── -->
        <fieldset class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">
            Captain Contact
          </legend>

          <div>
            <label for="contact-discord" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Discord Username <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="contact-discord"
              name="discord_username"
              placeholder="e.g. username#1234 or @username"
              required
              maxlength="50"
              autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
              aria-required="true"
            />
          </div>

          <div>
            <label for="contact-whatsapp" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              WhatsApp Number
            </label>
            <input
              type="tel"
              id="contact-whatsapp"
              name="whatsapp_number"
              placeholder="+92 3001234567"
              maxlength="15"
              inputmode="tel"
              autocomplete="tel"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors"
            />
          </div>
        </fieldset>

        <!-- ── Consent ── -->
        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="rules-consent"
            name="rules_consent"
            required
            class="mt-1 w-4 h-4 accent-[#00FF2A] flex-shrink-0"
            aria-required="true"
          />
          <label for="rules-consent" class="text-gray-400 text-sm leading-relaxed">
            I have read and agree to the
            <a href="/rules" class="text-neon hover:underline">Official NEXUS ESPORTS Rules</a>.
            All squad members will follow tournament guidelines and fair play policies.
          </label>
        </div>

        <!-- ── Submit ── -->
        <button
          type="submit"
          class="btn-neon w-full py-4 rounded text-base shadow-neon"
          id="submit-btn"
        >
          Submit Squad Registration
        </button>

        <!-- Success message (hidden by default) -->
        <div
          id="success-message"
          class="hidden text-center py-4 px-5 rounded border border-neon/30 bg-neon/10"
          role="alert"
          aria-live="polite"
        >
          <p class="font-tech font-700 text-neon uppercase tracking-widest text-lg mb-1">Registration Submitted!</p>
          <p class="text-gray-300 text-sm">Room details will be shared on Discord before the match. See you in the zone. 🎯</p>
        </div>

        <!-- Error message (hidden by default) -->
        <div
          id="error-message"
          class="hidden text-center py-3 px-5 rounded border border-red-500/30 bg-red-500/10"
          role="alert"
          aria-live="polite"
        >
          <p class="text-red-400 text-sm font-tech">Please fill in all required fields correctly.</p>
        </div>

      </form>

      <!-- Side note -->
      <div class="mt-6 card-dark rounded-xl p-4 border border-yellow-400/20 flex gap-3">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p class="text-gray-400 text-sm">
          <span class="text-yellow-400 font-tech font-700">Note:</span> Room ID and password will be shared via Discord/WhatsApp
          <strong class="text-white">30 minutes</strong> before the tournament starts. Make sure to join the community.
        </p>
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('registration-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('success-message') as HTMLDivElement;
  const errorMsg = document.getElementById('error-message') as HTMLDivElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    successMsg.classList.add('hidden');
    errorMsg.classList.add('hidden');

    if (!form.checkValidity()) {
      form.reportValidity();
      errorMsg.classList.remove('hidden');
      return;
    }

    // Simulate submission
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    setTimeout(() => {
      submitBtn.classList.add('hidden');
      successMsg.classList.remove('hidden');
      form.reset();
    }, 1000);
  });
</script>
