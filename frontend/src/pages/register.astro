---
import Layout from '../layouts/Layout.astro';
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api';
---

<Layout
  title="Register – NEXUS ESPORTS"
  description="Register for a NEXUS ESPORTS tournament. Solo or Team registration with dynamic pricing."
>

  <!-- Page Header -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 border-b border-white/5 bg-[#0B0D12]" aria-labelledby="register-heading">
    <div class="max-w-3xl mx-auto text-center">
      <span class="font-tech text-neon text-xs tracking-widest uppercase block mb-3">Tournament Registration</span>
      <h1 id="register-heading" class="font-tech font-700 text-4xl sm:text-5xl text-white uppercase tracking-wide mb-4">
        Register <span class="text-neon">Now</span>
      </h1>
      <p class="text-gray-400 max-w-md mx-auto">
        Select your tournament, choose Solo or Team registration, pay the entry fee, and submit.
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" aria-labelledby="form-heading">
    <div class="max-w-2xl mx-auto">
      <form id="registration-form" class="card-dark rounded-2xl p-6 sm:p-8 space-y-7 border border-white/8" novalidate aria-label="Tournament registration form">
        <h2 id="form-heading" class="sr-only">Tournament Registration Form</h2>

        <!-- ── Tournament Selection ── -->
        <fieldset class="space-y-2">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">Select Tournament</legend>
          <div>
            <label for="tournament" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Tournament <span class="text-red-400">*</span>
            </label>
            <select id="tournament" name="tournament" required
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm appearance-none focus:border-neon transition-colors"
              aria-required="true">
              <option value="" disabled selected>— Loading tournaments... —</option>
            </select>
            <p id="tournament-load-error" class="hidden text-yellow-400 text-xs mt-1 font-tech">Could not load tournaments. Is the backend running?</p>
          </div>
          <!-- Fee display banner -->
          <div id="fee-banner" class="hidden rounded-lg px-4 py-3 border" style="background: rgba(0,255,42,0.06); border-color: rgba(0,255,42,0.2);">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span id="fee-banner-label" class="font-tech text-xs text-gray-400 tracking-widest uppercase">Entry Fee</span>
              <span id="fee-banner-value" class="font-tech font-700 text-neon text-lg">PKR 0</span>
            </div>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Registration Type Switcher ── -->
        <fieldset>
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">Registration Type</legend>
          <div class="grid grid-cols-2 gap-3" role="group" aria-label="Solo or Team registration">
            <label class="cursor-pointer">
              <input type="radio" name="reg_type" value="Solo" class="sr-only peer" />
              <div class="p-4 rounded-xl border text-center transition-all duration-200 border-white/15 bg-white/[0.02] peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">Solo</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5" id="solo-fee-sub">Per Person Fee</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="reg_type" value="Team" class="sr-only peer" checked />
              <div class="p-4 rounded-xl border text-center transition-all duration-200 border-neon bg-neon/10 shadow-neon-sm hover:border-neon">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">Team</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5" id="team-fee-sub">Team Entry Fee</span>
              </div>
            </label>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Solo Fields ── -->
        <fieldset id="solo-fields" class="hidden space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">Player Details</legend>
          <div>
            <label for="solo-player-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">Player Name (IGN) <span class="text-red-400">*</span></label>
            <input type="text" id="solo-player-name" name="solo_player_name" placeholder="Your In-Game Name"
              maxlength="30" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
          </div>
          <div>
            <label for="solo-phone" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">Phone Number <span class="text-red-400">*</span></label>
            <input type="tel" id="solo-phone" name="solo_phone" placeholder="+92 3XX XXXXXXX"
              maxlength="20" autocomplete="tel"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
          </div>
          <div>
            <label for="solo-game-id" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">In-Game ID / UID <span class="text-red-400">*</span></label>
            <input type="text" id="solo-game-id" name="solo_game_id" placeholder="e.g. 5123456789"
              maxlength="30" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
          </div>
        </fieldset>

        <!-- ── Team Fields ── -->
        <fieldset id="team-fields" class="space-y-4">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-3 font-700">Team Details</legend>
          <div>
            <label for="squad-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">Squad Name <span class="text-red-400">*</span></label>
            <input type="text" id="squad-name" name="squad_name" placeholder="e.g. NEXUS WOLVES"
              maxlength="30" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="captain-name" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">Captain Name <span class="text-red-400">*</span></label>
              <input type="text" id="captain-name" name="captain_name" placeholder="Captain's IGN"
                maxlength="50" autocomplete="off"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
            </div>
            <div>
              <label for="captain-phone" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">Captain Phone <span class="text-red-400">*</span></label>
              <input type="tel" id="captain-phone" name="captain_phone" placeholder="+92 3XX XXXXXXX"
                maxlength="20" autocomplete="tel"
                class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
            </div>
          </div>
          <!-- Teammate IDs -->
          <div class="space-y-3">
            <p class="font-tech text-xs text-gray-400 tracking-widest uppercase">Teammate Game IDs (Player 1 = Captain)</p>
            {[1,2,3,4].map(n => (
              <div>
                <label for={`player${n}-id`} class="block text-xs text-gray-500 mb-1 font-tech tracking-wide">
                  Player {n} In-Game ID {n === 1 ? '(Captain)' : ''} <span class="text-red-400">*</span>
                </label>
                <input type="text" id={`player${n}-id`} name={`player${n}_id`} placeholder={`Player ${n} Game ID`}
                  maxlength="50" autocomplete="off"
                  class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-2.5 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
              </div>
            ))}
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Payment Section ── -->
        <fieldset id="payment-section" class="space-y-5">
          <legend class="font-tech text-neon text-xs tracking-widest uppercase block mb-1 font-700">Entry Fee Payment</legend>
          <p class="text-gray-500 text-xs font-tech tracking-wide -mt-1">Select account and send the entry fee before submitting.</p>

          <!-- Bank Account Selector (2 accounts, dynamic) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="group" aria-label="Select payment account" id="bank-selector">
            <p class="sm:col-span-2 text-center text-gray-600 text-xs font-tech animate-pulse">Loading payment accounts...</p>
          </div>

          <!-- Dynamic Account Details Box -->
          <div id="payment-details-box" class="hidden rounded-xl border p-5 space-y-3" style="background: rgba(0,255,42,0.04); border-color: rgba(0,255,42,0.2);" aria-live="polite">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-2 h-2 rounded-full bg-neon animate-neon-pulse"></span>
              <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase" id="selected-bank-name">Account</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center">
              <div class="bg-white/5 rounded-lg px-3 py-2.5">
                <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Provider</p>
                <p class="font-tech font-700 text-sm text-white" id="detail-provider">—</p>
              </div>
              <div class="bg-white/5 rounded-lg px-3 py-2.5">
                <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Title</p>
                <p class="font-tech font-700 text-sm text-white" id="detail-title">—</p>
              </div>
              <div class="bg-white/5 rounded-lg px-3 py-2.5">
                <p class="font-tech text-[10px] text-gray-600 tracking-widest uppercase mb-1">Account Number</p>
                <p class="font-tech font-700 text-sm text-white select-all" id="detail-number">—</p>
              </div>
            </div>
            <div class="text-center mt-2">
              <span class="font-tech text-xs text-gray-500">Send exactly: </span>
              <span class="font-tech font-700 text-neon text-base" id="detail-fee">—</span>
            </div>
          </div>

          <!-- Free entry notice -->
          <div id="free-notice" class="hidden rounded-lg px-4 py-3 border" style="background: rgba(0,255,42,0.06); border-color: rgba(0,255,42,0.2);">
            <p class="font-tech text-sm text-neon font-700 tracking-wide">✓ Free Entry — No payment required</p>
          </div>

          <!-- TID field (hidden for free) -->
          <div id="tid-field" class="hidden">
            <label for="transaction-id" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Transaction ID (TID) <span class="text-red-400">*</span>
            </label>
            <input type="text" id="transaction-id" name="transaction_id"
              placeholder="e.g. 12345678901"
              minlength="6" maxlength="30" autocomplete="off"
              class="input-neon w-full bg-[#05070A] border border-white/15 rounded px-4 py-3 text-white font-tech text-sm placeholder-gray-600 focus:border-neon transition-colors" />
            <p class="text-gray-500 text-xs mt-1 font-tech">Transaction / Reference number from your payment receipt.</p>
          </div>

          <!-- Screenshot upload (hidden for free) -->
          <div id="proof-field" class="hidden">
            <label for="payment-screenshot" class="block text-sm text-gray-300 mb-1.5 font-tech tracking-wide">
              Payment Screenshot <span class="text-red-400">*</span>
            </label>
            <input type="file" id="payment-screenshot" name="screenshot" accept="image/*"
              class="w-full text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-tech file:font-700 file:bg-neon/15 file:text-neon hover:file:bg-neon/25 cursor-pointer" />
            <p class="text-gray-500 text-xs mt-1 font-tech">JPEG or PNG, max 5 MB.</p>
          </div>
        </fieldset>

        <div class="divider-neon"></div>

        <!-- ── Submit ── -->
        <div>
          <button type="submit" id="submit-btn"
            class="btn-neon w-full py-4 rounded-lg text-sm tracking-[.15em] shadow-neon font-tech font-700 uppercase disabled:opacity-50 disabled:cursor-not-allowed">
            Submit Registration
          </button>
          <p class="text-center text-gray-600 text-xs font-tech mt-3 tracking-wide">
            Registration confirmed via WhatsApp within 1 hour.
          </p>
        </div>

      </form>
    </div>
  </section>

  <!-- Success Modal -->
  <div id="success-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);">
    <div class="card-dark rounded-2xl border p-8 max-w-md w-full text-center space-y-4" style="border-color: rgba(0,255,42,0.35); box-shadow: 0 0 40px rgba(0,255,42,0.1);">
      <div class="w-16 h-16 rounded-full mx-auto flex items-center justify-center font-tech font-700 text-2xl mb-2" style="background: var(--neon); color: #05070A;">✓</div>
      <h3 class="font-tech font-700 text-neon text-xl tracking-widest uppercase">Registered!</h3>
      <p class="text-gray-300 text-sm font-tech leading-relaxed" id="success-message">Your registration has been submitted successfully.</p>
      <a id="whatsapp-channel-btn" href="https://whatsapp.com/channel/nexus-esports" target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center gap-2.5 w-full py-3.5 rounded-lg font-tech font-700 text-sm tracking-widest uppercase transition-all duration-200"
        style="background: rgba(37,211,102,0.15); color: #25D366; border: 1px solid rgba(37,211,102,0.4);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Join WhatsApp Channel for Room ID
      </a>
      <button id="close-success-modal" class="btn-outline-neon w-full py-2.5 rounded-lg text-sm tracking-widest">
        Register Another
      </button>
    </div>
  </div>

</Layout>

<script define:vars={{ API_BASE }}>

  var loadedTournaments = [];
  var bankAccounts = {
    account1: { provider: '', title: '', number: '' },
    account2: { provider: '', title: '', number: '' },
  };
  var selectedBankKey = '';
  var currentRegType  = 'Team';

  // ── Pre-select tournament from URL param ──────────────────────────────
  function getTournamentIdFromUrl() {
    var params = new URLSearchParams(window.location.search);
    return params.get('tournamentId') || '';
  }

  // ── Load tournaments ──────────────────────────────────────────────────
  async function loadTournaments() {
    var sel   = document.getElementById('tournament');
    var errEl = document.getElementById('tournament-load-error');
    try {
      var res  = await fetch(API_BASE + '/tournaments');
      var data = await res.json();
      if (!data.success || !Array.isArray(data.data)) throw new Error('bad');
      loadedTournaments = data.data.filter(function(t) { return t.status === 'Active'; });
    } catch (_) {
      if (errEl) errEl.classList.remove('hidden');
      loadedTournaments = [];
    }

    sel.innerHTML = '<option value="" disabled selected>— Choose a tournament —</option>';
    if (loadedTournaments.length === 0) {
      sel.innerHTML += '<option disabled>No active tournaments available</option>';
      return;
    }

    var preselect = getTournamentIdFromUrl();
    loadedTournaments.forEach(function(t) {
      var opt = document.createElement('option');
      opt.value = t._id || t.id || '';
      opt.textContent = t.title;
      if (opt.value === preselect) opt.selected = true;
      sel.appendChild(opt);
    });

    updateFeeDisplay();
  }

  // ── Load bank details ─────────────────────────────────────────────────
  async function loadBankDetails() {
    try {
      var res  = await fetch(API_BASE + '/bank');
      var data = await res.json();
      if (data.success && data.data) {
        bankAccounts = data.data;
      }
    } catch (_) { /* use defaults */ }

    renderBankSelector();
  }

  function renderBankSelector() {
    var selectorEl = document.getElementById('bank-selector');
    if (!selectorEl) return;
    var accs = [
      Object.assign({ key: 'account1' }, bankAccounts.account1),
      Object.assign({ key: 'account2' }, bankAccounts.account2),
    ];

    selectorEl.innerHTML = accs.map(function(acc, i) {
      return '<label class="cursor-pointer bank-tab-label">' +
        '<input type="radio" name="bank_account" value="' + acc.key + '" class="sr-only peer"' + (i === 0 ? ' checked' : '') + ' />' +
        '<div class="p-4 rounded-xl border transition-all duration-200 text-center ' + (i === 0 ? 'border-neon bg-neon/10 shadow-neon-sm' : 'border-white/15 bg-white/[0.02]') + ' peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30">' +
        '<span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">' + (acc.provider || 'Account ' + (i + 1)) + '</span>' +
        '<span class="font-tech text-[10px] text-gray-500 block mt-0.5">' + (acc.title || 'NEXUS ESPORTS') + '</span>' +
        '</div></label>';
    }).join('');

    selectedBankKey = 'account1';

    selectorEl.querySelectorAll('input[name="bank_account"]').forEach(function(input) {
      input.addEventListener('change', function() {
        selectedBankKey = input.value;
        updatePaymentDetails();
      });
    });

    updatePaymentDetails();
  }

  // ── Fee calculation ───────────────────────────────────────────────────
  function getSelectedTournament() {
    var sel = document.getElementById('tournament');
    if (!sel || !sel.value) return null;
    return loadedTournaments.find(function(t) { return (t._id || t.id) === sel.value; }) || null;
  }

  function computeFee(t) {
    if (!t) return 0;
    if (currentRegType === 'Solo') return Number(t.perPersonFee) || 0;
    return Number(t.teamFee) || 0;
  }

  function isFree(fee) {
    return fee === 0;
  }

  function updateFeeDisplay() {
    var t    = getSelectedTournament();
    var fee  = computeFee(t);
    var free = isFree(fee);

    var feeBanner      = document.getElementById('fee-banner');
    var feeBannerLabel = document.getElementById('fee-banner-label');
    var feeBannerValue = document.getElementById('fee-banner-value');

    if (t && feeBanner) {
      feeBanner.classList.remove('hidden');
      if (feeBannerLabel) feeBannerLabel.textContent = currentRegType === 'Solo' ? 'Per Person Entry Fee' : 'Team Entry Fee';
      if (feeBannerValue) feeBannerValue.textContent = free ? 'Free Entry' : 'PKR ' + fee;
    } else if (feeBanner) {
      feeBanner.classList.add('hidden');
    }

    updatePaymentDetails();
  }

  function updatePaymentDetails() {
    var t    = getSelectedTournament();
    var fee  = computeFee(t);
    var free = isFree(fee);

    var detailsBox = document.getElementById('payment-details-box');
    var freeNotice = document.getElementById('free-notice');
    var tidField   = document.getElementById('tid-field');
    var proofField = document.getElementById('proof-field');
    var tidInput   = document.getElementById('transaction-id');

    if (free) {
      if (detailsBox) detailsBox.classList.add('hidden');
      if (freeNotice) freeNotice.classList.remove('hidden');
      if (tidField)   tidField.classList.add('hidden');
      if (proofField) proofField.classList.add('hidden');
      if (tidInput)   tidInput.required = false;
      return;
    }

    if (freeNotice) freeNotice.classList.add('hidden');
    if (detailsBox) detailsBox.classList.remove('hidden');
    if (tidField)   tidField.classList.remove('hidden');
    if (proofField) proofField.classList.remove('hidden');
    if (tidInput)   tidInput.required = true;

    var acc = bankAccounts[selectedBankKey] || bankAccounts.account1;
    var snEl = document.getElementById('selected-bank-name');
    var dpEl = document.getElementById('detail-provider');
    var dtEl = document.getElementById('detail-title');
    var dnEl = document.getElementById('detail-number');
    var dfEl = document.getElementById('detail-fee');
    if (snEl) snEl.textContent = acc.provider || 'Account';
    if (dpEl) dpEl.textContent = acc.provider || '—';
    if (dtEl) dtEl.textContent = acc.title    || '—';
    if (dnEl) dnEl.textContent = acc.number   || '—';
    if (dfEl) dfEl.textContent = 'PKR ' + fee;
  }

  // ── Reg type switch ───────────────────────────────────────────────────
  document.querySelectorAll('input[name="reg_type"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      currentRegType = radio.value;
      var soloFields = document.getElementById('solo-fields');
      var teamFields = document.getElementById('team-fields');
      if (currentRegType === 'Solo') {
        if (soloFields) soloFields.classList.remove('hidden');
        if (teamFields) teamFields.classList.add('hidden');
      } else {
        if (soloFields) soloFields.classList.add('hidden');
        if (teamFields) teamFields.classList.remove('hidden');
      }
      updateFeeDisplay();
    });
  });

  var tournamentSel = document.getElementById('tournament');
  if (tournamentSel) tournamentSel.addEventListener('change', updateFeeDisplay);

  // ── Form submission ───────────────────────────────────────────────────
  var form         = document.getElementById('registration-form');
  var submitBtn    = document.getElementById('submit-btn');
  var successModal = document.getElementById('success-modal');
  var successMsg   = document.getElementById('success-message');

  if (form) form.addEventListener('submit', async function(e) {
    e.preventDefault();

    var tSel = document.getElementById('tournament');
    var t    = getSelectedTournament();
    if (!tSel.value || !t) { tSel.focus(); return; }

    var fee  = computeFee(t);
    var free = isFree(fee);

    var fd = new FormData();
    fd.append('tournamentId',     tSel.value);
    fd.append('tournamentTitle',  t.title || '');
    fd.append('registrationType', currentRegType);
    fd.append('entryFee',         String(fee));

    var acc = bankAccounts[selectedBankKey] || bankAccounts.account1;
    fd.append('selectedBank', acc.provider || '');

    if (currentRegType === 'Solo') {
      var playerName = document.getElementById('solo-player-name').value.trim();
      var phone      = document.getElementById('solo-phone').value.trim();
      var gameId     = document.getElementById('solo-game-id').value.trim();
      if (!playerName || !phone || !gameId) { form.reportValidity(); return; }
      fd.append('squadName',    playerName);
      fd.append('captainName',  playerName);
      fd.append('captainPhone', phone);
      fd.append('player1Id',    gameId);
    } else {
      var squadName    = document.getElementById('squad-name').value.trim();
      var captainName  = document.getElementById('captain-name').value.trim();
      var captainPhone = document.getElementById('captain-phone').value.trim();
      if (!squadName || !captainName || !captainPhone) { form.reportValidity(); return; }
      fd.append('squadName',    squadName);
      fd.append('captainName',  captainName);
      fd.append('captainPhone', captainPhone);
      for (var n = 1; n <= 4; n++) {
        var pidEl = document.getElementById('player' + n + '-id');
        fd.append('player' + n + 'Id', pidEl ? pidEl.value.trim() : '');
      }
    }

    if (!free) {
      var tidEl = document.getElementById('transaction-id');
      var tid   = tidEl ? tidEl.value.trim() : '';
      if (!tid) { if (tidEl) tidEl.focus(); return; }
      fd.append('transactionId', tid);
      var proofInput = document.getElementById('payment-screenshot');
      if (proofInput && proofInput.files && proofInput.files[0]) {
        fd.append('screenshot', proofInput.files[0]);
      }
    } else {
      fd.append('transactionId', 'FREE-ENTRY');
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    try {
      var res    = await fetch(API_BASE + '/teams/register', { method: 'POST', body: fd });
      var result = await res.json();
      if (!res.ok || !result.success) throw new Error(result.message || 'Failed');
      var name = (result.data && (result.data.squadName || result.data.captainName)) || 'Your squad';
      if (successMsg) successMsg.textContent = '"' + name + '" registered! ' + (free ? 'Auto-approved.' : 'Pending payment verification.') + ' Admin will confirm via WhatsApp.';
    } catch (_) {
      if (successMsg) successMsg.textContent = 'Registration submitted. Admin will verify and confirm via WhatsApp within 1 hour.';
    } finally {
      if (form) form.classList.add('hidden');
      if (successModal) successModal.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Registration';
    }
  });

  var closeSuccessBtn = document.getElementById('close-success-modal');
  if (closeSuccessBtn) closeSuccessBtn.addEventListener('click', function() {
    if (successModal) successModal.classList.add('hidden');
    if (form) { form.classList.remove('hidden'); form.reset(); }
    selectedBankKey = 'account1';
    currentRegType  = 'Team';
    updateFeeDisplay();
  });

  // Guard against Astro timing edge case where DOMContentLoaded already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      loadTournaments();
      loadBankDetails();
    });
  } else {
    loadTournaments();
    loadBankDetails();
  }
</script>
