---
import '../../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Admin Login — NEXUS ESPORTS</title>
  </head>
  <body style="background: var(--bg-dark); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem;">

    <!-- Grid BG -->
    <div class="fixed inset-0 grid-bg opacity-30 pointer-events-none" aria-hidden="true"></div>

    <!-- Neon blob -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] pointer-events-none" style="background: radial-gradient(ellipse at center top, rgba(0,255,42,0.07) 0%, transparent 70%); filter: blur(40px);" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-md">

      <!-- Brand header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-3 group mb-4">
          <img src="/neXus_eSport_icon-removebg-preview.png" alt="NEXUS ESPORTS" width="40" height="40" class="w-10 h-10 object-contain transition-all group-hover:drop-shadow-[0_0_10px_#00FF2A]" />
          <span class="font-tech font-700 text-xl tracking-widest uppercase">
            <span style="color: var(--neon)">NEXUS</span>
            <span class="text-white"> ESPORTS</span>
          </span>
        </a>
        <p class="font-tech text-xs tracking-[.2em] uppercase text-gray-600 mt-2">Admin Access Portal</p>
      </div>

      <!-- Login card -->
      <div
        class="card-dark rounded-2xl p-7 sm:p-9"
        style="border: 1px solid rgba(0,255,42,0.2); box-shadow: 0 0 40px rgba(0,255,42,0.06), 0 0 80px rgba(0,255,42,0.03), inset 0 0 40px rgba(0,255,42,0.02);"
      >

        <!-- Decorative top line -->
        <div class="h-px w-full mb-7" style="background: linear-gradient(90deg, transparent, var(--neon), transparent); opacity: 0.4;"></div>

        <h1 class="font-tech font-700 text-2xl uppercase tracking-wider text-white text-center mb-1">Admin Login</h1>
        <p class="text-gray-600 text-xs font-tech tracking-wide text-center mb-7">Restricted access. Authorized personnel only.</p>

        <!-- Error alert -->
        <div
          id="login-error"
          class="hidden mb-5 px-4 py-3 rounded border font-tech text-sm flex items-center gap-2"
          style="background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.35); color: #EF4444;"
          role="alert"
          aria-live="polite"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="login-error-text">Invalid credentials. Access denied.</span>
        </div>

        <form id="login-form" class="space-y-5" novalidate aria-label="Admin login form">

          <!-- Username -->
          <div>
            <label for="admin-username" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">
              Username <span class="text-red-400">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input
                type="text"
                id="admin-username"
                name="username"
                autocomplete="username"
                required
                placeholder="Enter username"
                class="input-neon w-full pl-10 pr-4 py-3 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-all duration-200"
                style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);"
                aria-required="true"
              />
            </div>
          </div>

          <!-- Password -->
          <div>
            <label for="admin-password" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">
              Password <span class="text-red-400">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              </span>
              <input
                type="password"
                id="admin-password"
                name="password"
                autocomplete="current-password"
                required
                placeholder="Enter password"
                class="input-neon w-full pl-10 pr-12 py-3 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-all duration-200"
                style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);"
                aria-required="true"
              />
              <!-- Toggle visibility -->
              <button
                type="button"
                id="toggle-password"
                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-600 hover:text-gray-400 transition-colors"
                aria-label="Toggle password visibility"
              >
                <svg id="eye-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="login-submit"
            class="btn-neon w-full py-3.5 rounded-lg text-sm tracking-[.12em] mt-2 shadow-neon-sm relative overflow-hidden"
          >
            <span id="login-btn-text">Access Admin Panel</span>
            <span id="login-btn-loading" class="hidden absolute inset-0 flex items-center justify-center gap-2">
              <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
              Authenticating...
            </span>
          </button>

        </form>

        <!-- Bottom line -->
        <div class="h-px w-full mt-7" style="background: linear-gradient(90deg, transparent, rgba(255,255,255,0.06), transparent);"></div>
        <p class="text-center text-gray-700 text-[10px] font-tech tracking-widest uppercase mt-4">
          <a href="/" class="hover:text-gray-500 transition-colors">← Return to NEXUS ESPORTS</a>
        </p>
      </div>

    </div>

  </body>
</html>

<script>
  // Redirect if already logged in
  if (localStorage.getItem('nexus_admin_token') === 'nexus_admin_authenticated') {
    window.location.replace('/admin');
  }

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorBox = document.getElementById('login-error') as HTMLDivElement;
  const errorText = document.getElementById('login-error-text') as HTMLSpanElement;
  const submitBtn = document.getElementById('login-submit') as HTMLButtonElement;
  const btnText = document.getElementById('login-btn-text') as HTMLSpanElement;
  const btnLoading = document.getElementById('login-btn-loading') as HTMLSpanElement;
  const togglePwd = document.getElementById('toggle-password') as HTMLButtonElement;
  const pwdInput = document.getElementById('admin-password') as HTMLInputElement;
  const eyeIcon = document.getElementById('eye-icon') as unknown as SVGElement;

  // Toggle password visibility
  togglePwd?.addEventListener('click', () => {
    const isText = pwdInput.type === 'text';
    pwdInput.type = isText ? 'password' : 'text';
    eyeIcon.innerHTML = isText
      ? `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`
      : `<path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>`;
  });

  // Login submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');

    const username = (document.getElementById('admin-username') as HTMLInputElement).value.trim();
    const password = (document.getElementById('admin-password') as HTMLInputElement).value;

    // Show loading state
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');
    submitBtn.disabled = true;

    setTimeout(() => {
      if (username === 'admin' && password === 'admin123') {
        localStorage.setItem('nexus_admin_token', 'nexus_admin_authenticated');
        window.location.href = '/admin';
      } else {
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
        submitBtn.disabled = false;
        errorBox.classList.remove('hidden');
        errorText.textContent = 'Invalid credentials. Access denied.';
        // Shake animation
        form.style.animation = 'none';
        form.offsetHeight; // reflow
        form.style.animation = 'shake 0.35s ease';
      }
    }, 800);
  });
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-6px); }
    80% { transform: translateX(6px); }
  }
</style>
