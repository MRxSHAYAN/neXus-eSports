---
import AdminLayout from '../../layouts/AdminLayout.astro';
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api';
const UPLOADS_BASE = (import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api').replace('/api', '');
---

<AdminLayout title="Registered Teams" activePage="teams">

  <!-- Page Heading -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-4 h-px" style="background: var(--neon);"></div>
        <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Admin</span>
      </div>
      <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Registered <span style="color: var(--neon);">Squads</span></h2>
    </div>
    <!-- Stats Pills & Server Status -->
    <div class="flex items-center gap-2 flex-wrap">
      <span id="backend-status-pill" class="font-tech text-xs px-3 py-1.5 rounded-full flex items-center gap-1.5" style="background: rgba(0,255,42,0.08); color: var(--neon); border: 1px solid rgba(0,255,42,0.2);">
        <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
        <span id="backend-status-text">Fetching API...</span>
      </span>
      <span id="pill-total"    class="font-tech text-xs px-3 py-1.5 rounded-full" style="background: rgba(0,255,42,0.1); color: var(--neon); border: 1px solid rgba(0,255,42,0.2);">0 Total</span>
      <span id="pill-pending"  class="font-tech text-xs px-3 py-1.5 rounded-full badge-upcoming">0 Pending</span>
      <span id="pill-approved" class="font-tech text-xs px-3 py-1.5 rounded-full badge-live">0 Approved</span>
      <span id="pill-rejected" class="font-tech text-xs px-3 py-1.5 rounded-full badge-closed">0 Rejected</span>
    </div>
  </div>

  <!-- Offline / Fallback Warning Banner (hidden by default) -->
  <div id="backend-warning-banner" class="hidden mb-6 rounded-xl border p-4" style="background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.25);">
    <div class="flex items-start gap-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <p class="font-tech font-700 text-sm text-yellow-400 uppercase tracking-wide">Express Backend Offline</p>
        <p class="font-tech text-xs text-gray-400 mt-0.5">Could not reach the backend API. Check that the server is running and the <code class="text-neon font-mono">PUBLIC_API_URL</code> environment variable is set correctly.</p>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex gap-2 flex-wrap mb-4" role="tablist" aria-label="Filter squads by payment status">
    {[
      { value: 'all',      label: 'All Squads'           },
      { value: 'pending',  label: 'Pending Verification' },
      { value: 'approved', label: 'Approved'             },
      { value: 'rejected', label: 'Rejected'             },
    ].map(tab => (
      <button
        role="tab"
        data-tab={tab.value}
        class="filter-tab font-tech font-700 text-[10px] tracking-widest uppercase px-4 py-2 rounded-lg border transition-all duration-200"
        style="background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); color: #6B7280;"
        aria-selected="false"
      >
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Search Bar -->
  <div class="relative mb-5">
    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </span>
    <input type="search" id="teams-search" placeholder="Search squad name, captain, TID, tournament..."
      class="input-neon w-full pl-10 pr-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
      style="background: var(--bg-card); border: 1px solid rgba(255,255,255,0.1);"
      aria-label="Search teams" />
  </div>

  <!-- Teams Table Card -->
  <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
    <div class="overflow-x-auto">
      <table class="w-full" aria-label="Registered squads">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.06); background: rgba(0,0,0,0.2);">
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Squad</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Captain &amp; Contact</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden lg:table-cell">Players (IGN \| UID)</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden md:table-cell">Tournament</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Pay Method</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">TID</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Proof</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Status</th>
            <th class="text-right px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Actions</th>
          </tr>
        </thead>
        <tbody id="teams-tbody">
          <tr>
            <td colspan="9" class="px-5 py-12 text-center">
              <div class="inline-block w-6 h-6 border-2 border-neon border-t-transparent rounded-full animate-spin mb-2"></div>
              <p class="font-tech text-xs text-gray-400">Loading registered squads from MongoDB...</p>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="teams-empty" class="hidden px-5 py-12 text-center">
      <p class="font-tech text-sm text-gray-600">No squads match your filter or search query.</p>
    </div>
  </div>

  <!-- Delete Confirm Modal -->
  <div id="team-delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);">
    <div class="card-dark rounded-xl border p-6 max-w-sm w-full text-center" style="border-color: rgba(239,68,68,0.3);">
      <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center" style="background: rgba(239,68,68,0.1);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="23" y2="14"/><line x1="23" y1="8" x2="17" y2="14"/></svg>
      </div>
      <h4 class="font-tech font-700 text-base uppercase tracking-wide text-white mb-2">Remove Squad?</h4>
      <p class="text-gray-400 text-sm mb-5">This registration will be permanently removed from MongoDB.</p>
      <div class="flex gap-3 justify-center">
        <button id="confirm-team-delete" class="font-tech font-700 text-sm tracking-widest uppercase px-5 py-2.5 rounded-lg" style="background: rgba(239,68,68,0.15); color: #EF4444; border: 1px solid rgba(239,68,68,0.3);">Remove</button>
        <button id="cancel-team-delete" class="btn-outline-neon px-5 py-2.5 rounded-lg text-sm tracking-widest">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Proof Screenshot Modal -->
  <div id="proof-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(6px);">
    <div class="card-dark rounded-xl border p-6 max-w-md w-full" style="border-color: rgba(0,255,42,0.2);">
      <div class="flex items-center justify-between mb-4">
        <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">Payment Proof Screenshot</span>
        <button id="close-proof-modal" class="text-gray-500 hover:text-white transition-colors" aria-label="Close proof modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <p class="text-gray-400 text-xs font-tech mb-3">Submitted screenshot:</p>
      <div id="proof-preview-container" class="mb-4">
        <a id="proof-link" href="#" target="_blank" rel="noopener noreferrer"
          class="block break-all font-tech text-xs text-neon hover:underline mb-2">—</a>
        <img id="proof-image-preview" src="" alt="Payment Proof" class="max-h-64 rounded border border-white/10 w-full object-contain bg-black/40 hidden" />
      </div>
      <p class="text-gray-600 text-[10px] font-tech">Verify payment receipt details before approving or rejecting.</p>
    </div>
  </div>

</AdminLayout>

<script define:vars={{ API_BASE, UPLOADS_BASE }}>
  var currentTeams = [];
  var currentFilter = 'all';
  var searchQuery = '';
  var pendingDeleteId = null;
  var isBackendLive = false;

  function showToast(msg, isError) {
    isError = isError || false;
    var existing = document.getElementById('admin-toast');
    if (existing) existing.remove();
    var toast = document.createElement('div');
    toast.id = 'admin-toast';
    var color = isError ? 'rgba(239,68,68' : 'rgba(0,255,42';
    toast.style.cssText = 'position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;font-family:"Rajdhani",sans-serif;font-size:.875rem;padding:.75rem 1.25rem;border-radius:.5rem;background:' + color + ',0.15);border:1px solid ' + color + ',0.35);color:' + (isError ? '#EF4444' : 'var(--neon)') + ';transition:opacity .3s;';
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.textContent = (isError ? '✕' : '✓') + '  ' + msg;
    document.body.appendChild(toast);
    setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
  }

  async function fetchTeamsFromAPI() {
    var statusText = document.getElementById('backend-status-text');
    var warningBanner = document.getElementById('backend-warning-banner');

    try {
      var res = await fetch(API_BASE + '/teams');
      if (!res.ok) throw new Error('API return non-200');
      var result = await res.json();

      if (result.success && Array.isArray(result.data)) {
        currentTeams = result.data;
        isBackendLive = true;
        if (statusText) statusText.textContent = 'Backend Connected';
        if (warningBanner) warningBanner.classList.add('hidden');
      } else {
        throw new Error('Malformed API output');
      }
    } catch (err) {
      console.warn('⚠️ [Teams Admin] Could not reach backend API:', err);
      isBackendLive = false;
      currentTeams = [];
      if (statusText) statusText.textContent = 'Backend Offline';
      if (warningBanner) warningBanner.classList.remove('hidden');
    }

    renderTable();
    updatePills();
  }

  function updatePills() {
    var total    = currentTeams.length;
    var pending  = currentTeams.filter(function(t) { return (t.status || '').toLowerCase() === 'pending';  }).length;
    var approved = currentTeams.filter(function(t) { return (t.status || '').toLowerCase() === 'approved'; }).length;
    var rejected = currentTeams.filter(function(t) { return (t.status || '').toLowerCase() === 'rejected'; }).length;
    var pT = document.getElementById('pill-total');
    var pP = document.getElementById('pill-pending');
    var pA = document.getElementById('pill-approved');
    var pR = document.getElementById('pill-rejected');
    if (pT) pT.textContent = total + ' Total';
    if (pP) pP.textContent = pending + ' Pending';
    if (pA) pA.textContent = approved + ' Approved';
    if (pR) pR.textContent = rejected + ' Rejected';
  }

  function renderTable() {
    var tbody = document.getElementById('teams-tbody');
    var empty = document.getElementById('teams-empty');
    if (!tbody) return;

    var filtered = currentTeams.slice();
    if (currentFilter !== 'all') {
      filtered = filtered.filter(function(t) { return (t.status || 'pending').toLowerCase() === currentFilter; });
    }
    if (searchQuery) {
      var q = searchQuery.toLowerCase();
      filtered = filtered.filter(function(t) {
        return (t.name || '').toLowerCase().includes(q) ||
               (t.captain || '').toLowerCase().includes(q) ||
               (t.whatsapp || '').toLowerCase().includes(q) ||
               (t.transactionId || '').toLowerCase().includes(q) ||
               (t.tournament || '').toLowerCase().includes(q);
      });
    }

    if (filtered.length === 0) {
      tbody.innerHTML = '';
      if (empty) empty.classList.remove('hidden');
      return;
    }
    if (empty) empty.classList.add('hidden');

    tbody.innerHTML = filtered.map(function(t) {
      var statusLower = (t.status || 'Pending').toLowerCase();
      var statusBadge = '';
      if (statusLower === 'approved') statusBadge = '<span class="badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Approved</span>';
      else if (statusLower === 'rejected') statusBadge = '<span class="badge-closed font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Rejected</span>';
      else statusBadge = '<span class="badge-upcoming font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Pending</span>';

      var playersList = '<div class="font-tech text-xs text-gray-500">—</div>';
      if (t.player1Id || t.player2Id || t.player3Id || t.player4Id) {
        var ids = [t.player1Id, t.player2Id, t.player3Id, t.player4Id].filter(Boolean);
        playersList = ids.map(function(p) { return '<div class="font-tech text-xs text-gray-400">' + p + '</div>'; }).join('');
      } else if (Array.isArray(t.players) && t.players.length > 0) {
        playersList = t.players.map(function(p) { return '<div class="font-tech text-xs text-gray-400">' + p + '</div>'; }).join('');
      }

      var proofPath = t.screenshotUrl || t.paymentProof || t.logo || '';
      var proofDisplay = proofPath
        ? '<button data-proof="' + proofPath + '" class="btn-proof-view font-tech text-[10px] text-neon hover:underline tracking-wider uppercase">View Screenshot</button>'
        : '<span class="font-tech text-xs text-gray-600">—</span>';
      var id = t._id || t.id;

      return '<tr class="border-b transition-colors hover:bg-white/[0.02]" style="border-color: rgba(255,255,255,0.04);">' +
        '<td class="px-4 py-3"><p class="font-tech font-700 text-sm text-white tracking-wide">' + (t.squadName || t.name) + '</p><p class="font-tech text-[10px] text-gray-500">ID: ' + id + '</p></td>' +
        '<td class="px-4 py-3 hidden sm:table-cell"><p class="font-tech text-xs text-gray-300">' + (t.captainName || t.captain || '—') + '</p><p class="font-tech text-[10px] text-gray-500">' + (t.captainPhone || t.whatsapp || '') + '</p></td>' +
        '<td class="px-4 py-3 hidden lg:table-cell">' + playersList + '</td>' +
        '<td class="px-4 py-3 hidden md:table-cell"><p class="font-tech text-xs text-gray-400">' + (t.tournamentTitle || t.tournament || 'NEXUS CUP') + '</p></td>' +
        '<td class="px-4 py-3"><span class="font-tech text-xs text-gray-300 uppercase">' + (t.selectedBank || t.paymentMethod || 'free') + '</span></td>' +
        '<td class="px-4 py-3 font-mono text-xs text-neon">' + (t.transactionId || 'FREE') + '</td>' +
        '<td class="px-4 py-3 hidden sm:table-cell">' + proofDisplay + '</td>' +
        '<td class="px-4 py-3">' + statusBadge + '</td>' +
        '<td class="px-4 py-3 text-right"><div class="flex items-center justify-end gap-1.5">' +
        (statusLower !== 'approved' ? '<button data-id="' + id + '" data-action="approve" class="btn-action-approve font-tech text-[10px] font-700 tracking-wider uppercase px-2.5 py-1 rounded" style="background: rgba(0,255,42,0.12); color: var(--neon); border: 1px solid rgba(0,255,42,0.25);">Approve</button>' : '') +
        (statusLower !== 'rejected' ? '<button data-id="' + id + '" data-action="reject" class="btn-action-reject font-tech text-[10px] font-700 tracking-wider uppercase px-2.5 py-1 rounded" style="background: rgba(239,68,68,0.12); color: #EF4444; border: 1px solid rgba(239,68,68,0.25);">Reject</button>' : '') +
        '<button data-id="' + id + '" data-action="delete" class="btn-action-delete text-gray-600 hover:text-red-400 p-1 transition-colors" title="Delete Team"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg></button>' +
        '</div></td></tr>';
    }).join('');

    attachTableEvents();
  }

  function attachTableEvents() {
    document.querySelectorAll('.btn-action-approve').forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        var id = e.currentTarget.dataset.id;
        if (id) await updateTeamStatus(id, 'approved');
      });
    });

    document.querySelectorAll('.btn-action-reject').forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        var id = e.currentTarget.dataset.id;
        if (id) await updateTeamStatus(id, 'rejected');
      });
    });

    document.querySelectorAll('.btn-action-delete').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var id = e.currentTarget.dataset.id;
        if (id) {
          pendingDeleteId = id;
          var modal = document.getElementById('team-delete-modal');
          if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
        }
      });
    });

    document.querySelectorAll('.btn-proof-view').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var proof = e.currentTarget.dataset.proof || '';
        var modal = document.getElementById('proof-modal');
        var link  = document.getElementById('proof-link');
        var img   = document.getElementById('proof-image-preview');

        if (link) { link.href = proof.startsWith('http') ? proof : UPLOADS_BASE + proof; link.textContent = proof; }
        if (img) {
          if (proof.startsWith('/uploads/') || proof.endsWith('.jpg') || proof.endsWith('.png') || proof.endsWith('.webp')) {
            img.src = proof.startsWith('http') ? proof : UPLOADS_BASE + proof;
            img.classList.remove('hidden');
          } else { img.classList.add('hidden'); }
        }
        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
      });
    });
  }

  async function updateTeamStatus(id, newStatus) {
    var normStatus = newStatus.charAt(0).toUpperCase() + newStatus.slice(1).toLowerCase();
    var team = currentTeams.find(function(t) { return (t._id || t.id) === id; });
    if (team) team.status = normStatus;
    renderTable();
    updatePills();

    if (isBackendLive) {
      try {
        var res  = await fetch(API_BASE + '/teams/' + id + '/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: normStatus })
        });
        var data = await res.json();
        showToast(data.message || 'Status updated to ' + normStatus);
      } catch (_) {
        showToast('Status updated to ' + normStatus);
      }
    } else {
      showToast('Backend offline — status change not persisted.', true);
    }
  }

  var confirmDeleteBtn = document.getElementById('confirm-team-delete');
  if (confirmDeleteBtn) confirmDeleteBtn.addEventListener('click', async function() {
    if (!pendingDeleteId) return;
    var id = pendingDeleteId;
    var deleteModal = document.getElementById('team-delete-modal');
    if (deleteModal) deleteModal.classList.add('hidden');
    currentTeams = currentTeams.filter(function(t) { return (t._id || t.id) !== id; });
    renderTable();
    updatePills();
    if (isBackendLive) {
      try { await fetch(API_BASE + '/teams/' + id, { method: 'DELETE' }); showToast('Squad removed.'); }
      catch (_) { showToast('Squad removed locally. Backend may be offline.', true); }
    } else { showToast('Backend offline — deletion not persisted.', true); }
    pendingDeleteId = null;
  });

  var cancelDeleteBtn = document.getElementById('cancel-team-delete');
  if (cancelDeleteBtn) cancelDeleteBtn.addEventListener('click', function() {
    var m = document.getElementById('team-delete-modal');
    if (m) m.classList.add('hidden');
    pendingDeleteId = null;
  });

  var closeProofBtn = document.getElementById('close-proof-modal');
  if (closeProofBtn) closeProofBtn.addEventListener('click', function() {
    var m = document.getElementById('proof-modal');
    if (m) m.classList.add('hidden');
  });

  document.querySelectorAll('.filter-tab').forEach(function(tab) {
    tab.addEventListener('click', function(e) {
      currentFilter = e.currentTarget.dataset.tab || 'all';
      document.querySelectorAll('.filter-tab').forEach(function(t) {
        t.style.background  = 'rgba(255,255,255,0.03)';
        t.style.borderColor = 'rgba(255,255,255,0.08)';
        t.style.color       = '#6B7280';
        t.setAttribute('aria-selected', 'false');
      });
      e.currentTarget.style.background  = 'rgba(0,255,42,0.1)';
      e.currentTarget.style.borderColor = 'rgba(0,255,42,0.3)';
      e.currentTarget.style.color       = 'var(--neon)';
      e.currentTarget.setAttribute('aria-selected', 'true');
      renderTable();
    });
  });

  var teamsSearch = document.getElementById('teams-search');
  if (teamsSearch) teamsSearch.addEventListener('input', function(e) {
    searchQuery = e.target.value;
    renderTable();
  });

  // Guard against Astro timing edge case
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchTeamsFromAPI);
  } else {
    fetchTeamsFromAPI();
  }
</script>
