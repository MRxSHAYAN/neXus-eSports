---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Registered Teams" activePage="teams">

  <!-- Page Heading -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-4 h-px" style="background: var(--neon);"></div>
        <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Admin</span>
      </div>
      <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Registered <span style="color: var(--neon);">Squads</span></h2>
    </div>
    <!-- Stats Pills & Server Status -->
    <div class="flex items-center gap-2 flex-wrap">
      <span id="backend-status-pill" class="font-tech text-xs px-3 py-1.5 rounded-full flex items-center gap-1.5" style="background: rgba(0,255,42,0.08); color: var(--neon); border: 1px solid rgba(0,255,42,0.2);">
        <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
        <span id="backend-status-text">Fetching API...</span>
      </span>
      <span id="pill-total"    class="font-tech text-xs px-3 py-1.5 rounded-full" style="background: rgba(0,255,42,0.1); color: var(--neon); border: 1px solid rgba(0,255,42,0.2);">0 Total</span>
      <span id="pill-pending"  class="font-tech text-xs px-3 py-1.5 rounded-full badge-upcoming">0 Pending</span>
      <span id="pill-approved" class="font-tech text-xs px-3 py-1.5 rounded-full badge-live">0 Approved</span>
      <span id="pill-rejected" class="font-tech text-xs px-3 py-1.5 rounded-full badge-closed">0 Rejected</span>
    </div>
  </div>

  <!-- Offline / Fallback Warning Banner (hidden by default) -->
  <div id="backend-warning-banner" class="hidden mb-6 rounded-xl border p-4" style="background: rgba(251,191,36,0.06); border-color: rgba(251,191,36,0.25);">
    <div class="flex items-start gap-3">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <p class="font-tech font-700 text-sm text-yellow-400 uppercase tracking-wide">Express Backend Offline</p>
        <p class="font-tech text-xs text-gray-400 mt-0.5">Could not reach Express server at <code class="text-neon font-mono">http://localhost:5000/api/teams</code>. Operating in local fallback mode. Start the server using <code class="text-neon font-mono">cd backend && npm run dev</code> to enable live Google Sheets synchronization.</p>
      </div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex gap-2 flex-wrap mb-4" role="tablist" aria-label="Filter squads by payment status">
    {[
      { value: 'all',      label: 'All Squads'           },
      { value: 'pending',  label: 'Pending Verification' },
      { value: 'approved', label: 'Approved'             },
      { value: 'rejected', label: 'Rejected'             },
    ].map(tab => (
      <button
        role="tab"
        data-tab={tab.value}
        class="filter-tab font-tech font-700 text-[10px] tracking-widest uppercase px-4 py-2 rounded-lg border transition-all duration-200"
        style="background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); color: #6B7280;"
        aria-selected="false"
      >
        {tab.label}
      </button>
    ))}
  </div>

  <!-- Search Bar -->
  <div class="relative mb-5">
    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-600" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </span>
    <input type="search" id="teams-search" placeholder="Search squad name, captain, TID, tournament..."
      class="input-neon w-full pl-10 pr-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
      style="background: var(--bg-card); border: 1px solid rgba(255,255,255,0.1);"
      aria-label="Search teams" />
  </div>

  <!-- Teams Table Card -->
  <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
    <div class="overflow-x-auto">
      <table class="w-full" aria-label="Registered squads">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.06); background: rgba(0,0,0,0.2);">
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Squad</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Captain &amp; Contact</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden lg:table-cell">Players (IGN \| UID)</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden md:table-cell">Tournament</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Pay Method</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">TID</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Proof</th>
            <th class="text-left px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Status</th>
            <th class="text-right px-4 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Actions</th>
          </tr>
        </thead>
        <tbody id="teams-tbody">
          <tr>
            <td colspan="9" class="px-5 py-12 text-center">
              <div class="inline-block w-6 h-6 border-2 border-neon border-t-transparent rounded-full animate-spin mb-2"></div>
              <p class="font-tech text-xs text-gray-400">Loading registered squads from backend &amp; Google Sheets...</p>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="teams-empty" class="hidden px-5 py-12 text-center">
      <p class="font-tech text-sm text-gray-600">No squads match your filter or search query.</p>
    </div>
  </div>

  <!-- Delete Confirm Modal -->
  <div id="team-delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);">
    <div class="card-dark rounded-xl border p-6 max-w-sm w-full text-center" style="border-color: rgba(239,68,68,0.3);">
      <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center" style="background: rgba(239,68,68,0.1);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="17" y1="8" x2="23" y2="14"/><line x1="23" y1="8" x2="17" y2="14"/></svg>
      </div>
      <h4 class="font-tech font-700 text-base uppercase tracking-wide text-white mb-2">Remove Squad?</h4>
      <p class="text-gray-400 text-sm mb-5">This squad will be removed from backend and Google Sheets.</p>
      <div class="flex gap-3 justify-center">
        <button id="confirm-team-delete" class="font-tech font-700 text-sm tracking-widest uppercase px-5 py-2.5 rounded-lg" style="background: rgba(239,68,68,0.15); color: #EF4444; border: 1px solid rgba(239,68,68,0.3);">Remove</button>
        <button id="cancel-team-delete" class="btn-outline-neon px-5 py-2.5 rounded-lg text-sm tracking-widest">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Proof Screenshot Modal -->
  <div id="proof-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(6px);">
    <div class="card-dark rounded-xl border p-6 max-w-md w-full" style="border-color: rgba(0,255,42,0.2);">
      <div class="flex items-center justify-between mb-4">
        <span class="font-tech font-700 text-sm text-neon tracking-widest uppercase">Payment Proof Screenshot</span>
        <button id="close-proof-modal" class="text-gray-500 hover:text-white transition-colors" aria-label="Close proof modal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <p class="text-gray-400 text-xs font-tech mb-3">Submitted screenshot:</p>
      <div id="proof-preview-container" class="mb-4">
        <a id="proof-link" href="#" target="_blank" rel="noopener noreferrer"
          class="block break-all font-tech text-xs text-neon hover:underline mb-2">—</a>
        <img id="proof-image-preview" src="" alt="Payment Proof" class="max-h-64 rounded border border-white/10 w-full object-contain bg-black/40 hidden" />
      </div>
      <p class="text-gray-600 text-[10px] font-tech">Verify payment receipt details before approving or rejecting.</p>
    </div>
  </div>

</AdminLayout>

<script>
  const API_BASE = 'http://localhost:5000/api';
  const STORAGE_KEY = 'nexus_admin_teams';

  let currentTeams: any[] = [];
  let currentFilter = 'all';
  let searchQuery = '';
  let pendingDeleteId: string | null = null;
  let isBackendLive = false;

  const defaultFallbackTeams = [
    { id: 'team-001', name: 'GHOST WOLVES', captain: '@ghostwolf#1234', whatsapp: '+92 3001112222', tournament: 'NEXUS OPEN CUP #12', date: 'Aug 1, 2026', status: 'approved', paymentMethod: 'jazzcash', transactionId: '12345678901', paymentProof: '', entryFee: 'PKR 500 / Squad', players: ['GhostWolf|5123456789','NightHawk|5234567890','IceViper|5345678901','DarkBlade|5456789012'] },
    { id: 'team-002', name: 'IRON FIST', captain: '@ironfist#5678', whatsapp: '+92 3003334444', tournament: 'WEEKEND WARRIOR S3', date: 'Aug 2, 2026', status: 'pending', paymentMethod: 'easypaisa', transactionId: '98765432100', paymentProof: '/uploads/proof-002.jpg', entryFee: 'PKR 100 / Squad', players: ['IronFist|6123456789','SteelClaw|6234567890','RockSolid|6345678901','BoulderMan|6456789012'] },
    { id: 'team-003', name: 'DARK PHOENIX', captain: '@dphoenix#9012', whatsapp: '+92 3005556666', tournament: 'MIRAMAR MAYHEM', date: 'Aug 2, 2026', status: 'pending', paymentMethod: 'sadapay', transactionId: '11223344556', paymentProof: '', entryFee: 'PKR 75 / Squad', players: ['DarkPhoenix|7123456789','Ember|7234567890','Blaze|7345678901','Cinder|7456789012'] }
  ];

  function showToast(msg: string, isError = false) {
    const existing = document.getElementById('admin-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'admin-toast';
    const color = isError ? 'rgba(239,68,68' : 'rgba(0,255,42';
    toast.style.cssText = `position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;font-family:"Rajdhani",sans-serif;font-size:.875rem;padding:.75rem 1.25rem;border-radius:.5rem;background:${color},0.15);border:1px solid ${color},0.35);color:${isError?'#EF4444':'var(--neon)'};transition:opacity .3s;`;
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.textContent = `${isError ? '✕' : '✓'}  ${msg}`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
  }

  // Fetch teams from backend API
  async function fetchTeamsFromAPI() {
    const statusText = document.getElementById('backend-status-text');
    const warningBanner = document.getElementById('backend-warning-banner');

    try {
      const res = await fetch(`${API_BASE}/teams`);
      if (!res.ok) throw new Error('API return non-200');
      const result = await res.json();

      if (result.success && Array.isArray(result.data)) {
        currentTeams = result.data;
        isBackendLive = true;
        if (statusText) statusText.textContent = `Google Sheets (${result.source || 'Live'})`;
        if (warningBanner) warningBanner.classList.add('hidden');
      } else {
        throw new Error('Malformed API output');
      }
    } catch (err) {
      console.warn('⚠️ [Teams Admin] Could not reach backend API at http://localhost:5000/api/teams:', err);
      isBackendLive = false;
      if (statusText) statusText.textContent = 'Offline (Fallback Mode)';
      if (warningBanner) warningBanner.classList.remove('hidden');

      // Load fallback data from localStorage or default array
      try {
        currentTeams = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null') || defaultFallbackTeams;
      } catch {
        currentTeams = defaultFallbackTeams;
      }
    }

    renderTable();
    updatePills();
  }

  function updatePills() {
    const total = currentTeams.length;
    const pending = currentTeams.filter(t => t.status?.toLowerCase() === 'pending').length;
    const approved = currentTeams.filter(t => t.status?.toLowerCase() === 'approved').length;
    const rejected = currentTeams.filter(t => t.status?.toLowerCase() === 'rejected').length;

    const pT = document.getElementById('pill-total');
    const pP = document.getElementById('pill-pending');
    const pA = document.getElementById('pill-approved');
    const pR = document.getElementById('pill-rejected');

    if (pT) pT.textContent = `${total} Total`;
    if (pP) pP.textContent = `${pending} Pending`;
    if (pA) pA.textContent = `${approved} Approved`;
    if (pR) pR.textContent = `${rejected} Rejected`;
  }

  function renderTable() {
    const tbody = document.getElementById('teams-tbody');
    const empty = document.getElementById('teams-empty');
    if (!tbody) return;

    let filtered = [...currentTeams];
    if (currentFilter !== 'all') {
      filtered = filtered.filter(t => (t.status || 'pending').toLowerCase() === currentFilter);
    }
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(t =>
        (t.name || '').toLowerCase().includes(q) ||
        (t.captain || '').toLowerCase().includes(q) ||
        (t.whatsapp || '').toLowerCase().includes(q) ||
        (t.transactionId || '').toLowerCase().includes(q) ||
        (t.tournament || '').toLowerCase().includes(q)
      );
    }

    if (filtered.length === 0) {
      tbody.innerHTML = '';
      empty?.classList.remove('hidden');
      return;
    }

    empty?.classList.add('hidden');

    tbody.innerHTML = filtered.map(t => {
      const statusLower = (t.status || 'pending').toLowerCase();
      let statusBadge = '';
      if (statusLower === 'approved') statusBadge = '<span class="badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Approved</span>';
      else if (statusLower === 'rejected') statusBadge = '<span class="badge-closed font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Rejected</span>';
      else statusBadge = '<span class="badge-upcoming font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Pending</span>';

      const playersList = Array.isArray(t.players)
        ? t.players.map((p: string) => `<div class="font-tech text-xs text-gray-400">${p}</div>`).join('')
        : '<div class="font-tech text-xs text-gray-500">—</div>';

      const proofPath = t.paymentProof || t.logo || '';
      const proofDisplay = proofPath
        ? `<button data-proof="${proofPath}" class="btn-proof-view font-tech text-[10px] text-neon hover:underline tracking-wider uppercase">View Screenshot</button>`
        : '<span class="font-tech text-xs text-gray-600">—</span>';

      return `
        <tr class="border-b transition-colors hover:bg-white/[0.02]" style="border-color: rgba(255,255,255,0.04);">
          <td class="px-4 py-3">
            <p class="font-tech font-700 text-sm text-white tracking-wide">${t.name}</p>
            <p class="font-tech text-[10px] text-gray-500">ID: ${t.id}</p>
          </td>
          <td class="px-4 py-3 hidden sm:table-cell">
            <p class="font-tech text-xs text-gray-300">${t.captain || '—'}</p>
            <p class="font-tech text-[10px] text-gray-500">${t.whatsapp || ''}</p>
          </td>
          <td class="px-4 py-3 hidden lg:table-cell">${playersList}</td>
          <td class="px-4 py-3 hidden md:table-cell">
            <p class="font-tech text-xs text-gray-400">${t.tournament || 'NEXUS CUP'}</p>
          </td>
          <td class="px-4 py-3">
            <span class="font-tech text-xs text-gray-300 uppercase">${t.paymentMethod || 'free'}</span>
          </td>
          <td class="px-4 py-3 font-mono text-xs text-neon">${t.transactionId || 'FREE'}</td>
          <td class="px-4 py-3 hidden sm:table-cell">${proofDisplay}</td>
          <td class="px-4 py-3">${statusBadge}</td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-1.5">
              ${statusLower !== 'approved' ? `<button data-id="${t.id}" data-action="approve" class="btn-action-approve font-tech text-[10px] font-700 tracking-wider uppercase px-2.5 py-1 rounded" style="background: rgba(0,255,42,0.12); color: var(--neon); border: 1px solid rgba(0,255,42,0.25);">Approve</button>` : ''}
              ${statusLower !== 'rejected' ? `<button data-id="${t.id}" data-action="reject" class="btn-action-reject font-tech text-[10px] font-700 tracking-wider uppercase px-2.5 py-1 rounded" style="background: rgba(239,68,68,0.12); color: #EF4444; border: 1px solid rgba(239,68,68,0.25);">Reject</button>` : ''}
              <button data-id="${t.id}" data-action="delete" class="btn-action-delete text-gray-600 hover:text-red-400 p-1 transition-colors" title="Delete Team">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
              </button>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    attachTableEvents();
  }

  function attachTableEvents() {
    // Approve buttons
    document.querySelectorAll('.btn-action-approve').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) await updateTeamStatus(id, 'approved');
      });
    });

    // Reject buttons
    document.querySelectorAll('.btn-action-reject').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) await updateTeamStatus(id, 'rejected');
      });
    });

    // Delete buttons
    document.querySelectorAll('.btn-action-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.id;
        if (id) {
          pendingDeleteId = id;
          document.getElementById('team-delete-modal')?.classList.remove('hidden');
          document.getElementById('team-delete-modal')?.classList.add('flex');
        }
      });
    });

    // View screenshot proof modal
    document.querySelectorAll('.btn-proof-view').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const proof = (e.currentTarget as HTMLElement).dataset.proof || '';
        const modal = document.getElementById('proof-modal');
        const link = document.getElementById('proof-link') as HTMLAnchorElement;
        const img = document.getElementById('proof-image-preview') as HTMLImageElement;

        if (link) {
          link.href = proof.startsWith('http') ? proof : `http://localhost:5000${proof}`;
          link.textContent = proof;
        }

        if (img) {
          if (proof.startsWith('/uploads/') || proof.endsWith('.jpg') || proof.endsWith('.png') || proof.endsWith('.webp')) {
            img.src = proof.startsWith('http') ? proof : `http://localhost:5000${proof}`;
            img.classList.remove('hidden');
          } else {
            img.classList.add('hidden');
          }
        }

        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      });
    });
  }

  // Update status via API & Google Sheets
  async function updateTeamStatus(id: string, newStatus: string) {
    // Optimistic UI update
    const team = currentTeams.find(t => t.id === id);
    if (team) team.status = newStatus;
    renderTable();
    updatePills();

    if (isBackendLive) {
      try {
        const res = await fetch(`${API_BASE}/teams/${id}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });
        const data = await res.json();
        showToast(data.message || `Team status updated to ${newStatus}`);
      } catch (err) {
        showToast(`Updated status to ${newStatus} (Local)`);
      }
    } else {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(currentTeams));
      showToast(`Team status updated to ${newStatus} (Fallback mode)`);
    }
  }

  // Confirm delete
  document.getElementById('confirm-team-delete')?.addEventListener('click', async () => {
    if (!pendingDeleteId) return;
    const id = pendingDeleteId;
    document.getElementById('team-delete-modal')?.classList.add('hidden');

    currentTeams = currentTeams.filter(t => t.id !== id);
    renderTable();
    updatePills();

    if (isBackendLive) {
      try {
        await fetch(`${API_BASE}/teams/${id}`, { method: 'DELETE' });
        showToast(`Squad '${id}' removed from backend & Google Sheets.`);
      } catch {
        showToast(`Squad '${id}' removed.`);
      }
    } else {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(currentTeams));
      showToast(`Squad '${id}' removed.`);
    }
    pendingDeleteId = null;
  });

  document.getElementById('cancel-team-delete')?.addEventListener('click', () => {
    document.getElementById('team-delete-modal')?.classList.add('hidden');
    pendingDeleteId = null;
  });

  document.getElementById('close-proof-modal')?.addEventListener('click', () => {
    document.getElementById('proof-modal')?.classList.add('hidden');
  });

  // Filter tabs
  document.querySelectorAll('.filter-tab').forEach(tab => {
    tab.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      currentFilter = target.dataset.tab || 'all';

      document.querySelectorAll('.filter-tab').forEach(t => {
        (t as HTMLElement).style.background = 'rgba(255,255,255,0.03)';
        (t as HTMLElement).style.borderColor = 'rgba(255,255,255,0.08)';
        (t as HTMLElement).style.color = '#6B7280';
        t.setAttribute('aria-selected', 'false');
      });

      target.style.background = 'rgba(0,255,42,0.1)';
      target.style.borderColor = 'rgba(0,255,42,0.3)';
      target.style.color = 'var(--neon)';
      target.setAttribute('aria-selected', 'true');

      renderTable();
    });
  });

  // Search filter
  document.getElementById('teams-search')?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    renderTable();
  });

  // Mount init
  document.addEventListener('DOMContentLoaded', fetchTeamsFromAPI);
</script>
