---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard Overview" activePage="dashboard">

  <!-- ── Page heading ── -->
  <div class="flex items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-4 h-px" style="background: var(--neon);"></div>
        <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Command Center</span>
      </div>
      <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Dashboard <span style="color: var(--neon);">Overview</span></h2>
    </div>
    <div id="sheets-connection-badge" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs font-tech tracking-wider uppercase" style="background: rgba(0,255,42,0.08); border-color: rgba(0,255,42,0.2); color: var(--neon);">
      <span class="w-2 h-2 rounded-full bg-neon animate-pulse"></span>
      <span id="sheets-status-label">Checking API...</span>
    </div>
  </div>

  <!-- ── STAT WIDGETS ── -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-8" id="stat-widgets">

    <!-- Total Squads -->
    <div class="card-dark rounded-xl p-5 border relative overflow-hidden group hover:card-neon-border transition-all duration-300" style="border-color: rgba(0,255,42,0.15);">
      <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, var(--neon), rgba(0,255,42,0.3));"></div>
      <div class="flex items-start justify-between mb-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(0,255,42,0.1);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00FF2A" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <span class="font-tech text-[10px] tracking-widest uppercase px-2 py-0.5 rounded" style="background: rgba(0,255,42,0.1); color: var(--neon); border: 1px solid rgba(0,255,42,0.25);">Live Sync</span>
      </div>
      <p class="font-tech font-700 text-3xl text-white mb-1" id="stat-squads">...</p>
      <p class="font-tech text-xs tracking-widest uppercase text-gray-500">Total Registered Squads</p>
    </div>

    <!-- Approved Squads -->
    <div class="card-dark rounded-xl p-5 border relative overflow-hidden group hover:card-neon-border transition-all duration-300" style="border-color: rgba(0,255,42,0.15);">
      <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, #FBBF24, rgba(251,191,36,0.3));"></div>
      <div class="flex items-start justify-between mb-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(251,191,36,0.1);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full animate-neon-pulse" style="background: var(--neon);"></span>
          <span class="font-tech text-[10px] tracking-widest uppercase" style="color: var(--neon);">Verified</span>
        </div>
      </div>
      <p class="font-tech font-700 text-3xl text-white mb-1" id="stat-approved">...</p>
      <p class="font-tech text-xs tracking-widest uppercase text-gray-500">Approved Squads</p>
    </div>

    <!-- Revenue / Fees -->
    <div class="card-dark rounded-xl p-5 border relative overflow-hidden group hover:card-neon-border transition-all duration-300" style="border-color: rgba(0,255,42,0.15);">
      <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, #A78BFA, rgba(167,139,250,0.3));"></div>
      <div class="flex items-start justify-between mb-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(167,139,250,0.1);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <span class="font-tech text-[10px] tracking-widest uppercase px-2 py-0.5 rounded" style="background: rgba(167,139,250,0.1); color: #A78BFA; border: 1px solid rgba(167,139,250,0.25);">PKR Collected</span>
      </div>
      <p class="font-tech font-700 text-3xl text-white mb-1" id="stat-revenue">...</p>
      <p class="font-tech text-xs tracking-widest uppercase text-gray-500">Total Entry Fees</p>
    </div>

    <!-- Pending Approvals -->
    <div class="card-dark rounded-xl p-5 border relative overflow-hidden group hover:card-neon-border transition-all duration-300" style="border-color: rgba(0,255,42,0.15);">
      <div class="absolute top-0 left-0 right-0 h-0.5" style="background: linear-gradient(90deg, #F87171, rgba(248,113,113,0.3));"></div>
      <div class="flex items-start justify-between mb-4">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(248,113,113,0.1);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <span class="font-tech text-[10px] tracking-widest uppercase px-2 py-0.5 rounded" style="background: rgba(248,113,113,0.1); color: #F87171; border: 1px solid rgba(248,113,113,0.25);">Action needed</span>
      </div>
      <p class="font-tech font-700 text-3xl text-white mb-1" id="stat-pending">...</p>
      <p class="font-tech text-xs tracking-widest uppercase text-gray-500">Pending Approvals</p>
    </div>

  </div>

  <!-- ── TWO COLUMN: Recent Regs + Quick Actions ── -->
  <div class="grid grid-cols-1 xl:grid-cols-[1fr_300px] gap-6">

    <!-- RECENT REGISTRATIONS TABLE -->
    <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
      <div class="flex items-center justify-between px-5 py-4 border-b" style="border-color: rgba(255,255,255,0.06);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white">Recent Registrations</h3>
        <a href="/admin/teams" class="font-tech text-xs tracking-widest uppercase transition-colors hover:underline" style="color: var(--neon);">View All →</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full" aria-label="Recent squad registrations">
          <thead>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
              <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Squad Name</th>
              <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Captain Contact</th>
              <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden md:table-cell">Tournament</th>
              <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">TID / Fee</th>
              <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Status</th>
            </tr>
          </thead>
          <tbody id="recent-regs-tbody">
            <!-- Populated by JS -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="space-y-4">

      <!-- Quick stats mini -->
      <div class="card-dark rounded-xl border p-5" style="border-color: rgba(0,255,42,0.1);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white mb-4">Quick Actions</h3>
        <div class="space-y-2.5">
          <a href="/admin/teams" class="flex items-center gap-3 w-full px-4 py-3 rounded-lg font-tech text-sm tracking-wide text-white transition-all duration-200 hover:shadow-neon-sm" style="background: rgba(0,255,42,0.1); border: 1px solid rgba(0,255,42,0.2);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00FF2A" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            <span style="color: var(--neon);">Manage Squads &amp; Approvals</span>
          </a>
          <a href="/admin/bank" class="flex items-center gap-3 w-full px-4 py-3 rounded-lg font-tech text-sm tracking-wide text-gray-300 transition-all duration-200 hover:text-white hover:bg-white/8" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            Bank &amp; Payment Settings
          </a>
          <a href="/register" target="_blank" class="flex items-center gap-3 w-full px-4 py-3 rounded-lg font-tech text-sm tracking-wide text-gray-300 transition-all duration-200 hover:text-white hover:bg-white/8" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            Live Registration Page
          </a>
        </div>
      </div>

      <!-- Activity feed -->
      <div class="card-dark rounded-xl border p-5" style="border-color: rgba(0,255,42,0.1);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white mb-4">Activity Feed</h3>
        <div id="activity-feed" class="space-y-3">
          <!-- Populated by JS -->
        </div>
      </div>

    </div>
  </div>

</AdminLayout>

<script>
  const API_BASE = 'http://localhost:5000/api';

  async function loadDashboardMetrics() {
    const label = document.getElementById('sheets-status-label');
    const badge = document.getElementById('sheets-connection-badge');

    try {
      const [statsRes, teamsRes] = await Promise.all([
        fetch(`${API_BASE}/admin/stats`),
        fetch(`${API_BASE}/teams`)
      ]);

      const stats = await statsRes.json();
      const teamsData = await teamsRes.json();

      if (stats.success && stats.data) {
        const d = stats.data;
        document.getElementById('stat-squads')!.textContent = String(d.totalTeams || 0);
        document.getElementById('stat-approved')!.textContent = String(d.approvedTeams || 0);
        document.getElementById('stat-pending')!.textContent = String(d.pendingTeams || 0);
        document.getElementById('stat-revenue')!.textContent = `PKR ${d.totalRevenuePKR || 0}`;

        if (label) label.textContent = d.googleSheetsConnected ? 'Google Sheets Live' : 'Backend Connected';
      }

      if (teamsData.success && Array.isArray(teamsData.data)) {
        renderRecentTeams(teamsData.data);
      }
    } catch (err) {
      console.warn('⚠️ [Admin Dashboard] Could not reach backend API at http://localhost:5000/api:', err);
      if (label) label.textContent = 'Backend Offline (Local Mode)';
      if (badge) {
        badge.style.background = 'rgba(239,68,68,0.1)';
        badge.style.borderColor = 'rgba(239,68,68,0.3)';
        badge.style.color = '#EF4444';
      }

      // Load fallback data from localStorage
      const defaultTeams = [
        { name: 'GHOST WOLVES', captain: '@ghostwolf#1234', tournament: 'NEXUS OPEN CUP #12', date: 'Aug 1, 2026', status: 'approved', transactionId: 'FREE-ENTRY' },
        { name: 'IRON FIST', captain: '@ironfist#5678', tournament: 'WEEKEND WARRIOR S3', date: 'Aug 2, 2026', status: 'pending', transactionId: 'TXN98765' },
        { name: 'DARK PHOENIX', captain: '@dphoenix#9012', tournament: 'MIRAMAR MAYHEM', date: 'Aug 2, 2026', status: 'pending', transactionId: 'TXN11223' }
      ];

      let teams = defaultTeams;
      try {
        const local = localStorage.getItem('nexus_admin_teams');
        if (local) teams = JSON.parse(local);
      } catch {}

      const pending = teams.filter(t => t.status?.toLowerCase() === 'pending').length;
      const approved = teams.filter(t => t.status?.toLowerCase() === 'approved').length;

      document.getElementById('stat-squads')!.textContent = String(teams.length);
      document.getElementById('stat-approved')!.textContent = String(approved);
      document.getElementById('stat-pending')!.textContent = String(pending);
      document.getElementById('stat-revenue')!.textContent = 'PKR 1,250';

      renderRecentTeams(teams);
    }
  }

  function renderRecentTeams(teams: any[]) {
    const tbody = document.getElementById('recent-regs-tbody') as HTMLTableSectionElement;
    if (!tbody) return;

    tbody.innerHTML = '';
    const recent = [...teams].slice(0, 6);

    recent.forEach((team: any) => {
      const statusLower = (team.status || 'pending').toLowerCase();
      let badgeClass = 'badge-upcoming';
      if (statusLower === 'approved') badgeClass = 'badge-live';
      if (statusLower === 'rejected') badgeClass = 'badge-closed';

      const tr = document.createElement('tr');
      tr.style.cssText = 'border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s;';
      tr.innerHTML = `
        <td class="px-5 py-3.5">
          <span class="font-tech font-700 text-sm text-white">${team.name}</span>
        </td>
        <td class="px-5 py-3.5 hidden sm:table-cell">
          <span class="font-tech text-xs text-gray-400">${team.captain || '—'}</span>
        </td>
        <td class="px-5 py-3.5 hidden md:table-cell">
          <span class="font-tech text-xs text-gray-400 truncate block max-w-[150px]">${team.tournament || 'NEXUS CUP'}</span>
        </td>
        <td class="px-5 py-3.5">
          <span class="font-tech font-mono text-xs text-neon">${team.transactionId || 'FREE'}</span>
        </td>
        <td class="px-5 py-3.5">
          <span class="${badgeClass} font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">
            ${team.status || 'Pending'}
          </span>
        </td>
      `;
      tbody.appendChild(tr);
    });

    // Activity feed
    const feed = document.getElementById('activity-feed') as HTMLDivElement;
    if (feed) {
      feed.innerHTML = '';
      const items = [
        { icon: '🎮', text: `<strong class="text-white">${teams[0]?.name || 'ALPHA SQUAD'}</strong> registered for tournament`, time: 'Just now', color: 'var(--neon)' },
        { icon: '📊', text: 'Google Sheets synchronization active', time: '5m ago', color: '#34D399' },
        { icon: '⚠️', text: `${teams.filter(t => t.status === 'pending').length} squads awaiting approval`, time: '10m ago', color: '#FBBF24' }
      ];

      items.forEach(a => {
        const el = document.createElement('div');
        el.className = 'flex items-start gap-2.5';
        el.innerHTML = `
          <span class="text-base mt-0.5 flex-shrink-0">${a.icon}</span>
          <div class="flex-1 min-w-0">
            <p class="font-tech text-xs text-gray-400 leading-relaxed">${a.text}</p>
            <p class="font-tech text-[10px] tracking-wide mt-0.5" style="color: ${a.color}; opacity: 0.6;">${a.time}</p>
          </div>
        `;
        feed.appendChild(el);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', loadDashboardMetrics);
</script>
