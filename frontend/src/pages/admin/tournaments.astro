---
import AdminLayout from '../../layouts/AdminLayout.astro';
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api';
---

<AdminLayout title="Manage Tournaments" activePage="tournaments">

  <!-- Page heading -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-4 h-px" style="background: var(--neon);"></div>
        <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Admin</span>
      </div>
      <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Manage <span style="color: var(--neon);">Tournaments</span></h2>
    </div>
    <button id="open-add-form" class="btn-neon px-5 py-2.5 rounded-lg text-sm tracking-[.1em] flex items-center gap-2 shadow-neon-sm self-start sm:self-auto">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Tournament
    </button>
  </div>

  <!-- Add / Edit Form Panel -->
  <div id="tournament-form-panel" class="hidden mb-8">
    <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.2); box-shadow: 0 0 24px rgba(0,255,42,0.05);">
      <div class="flex items-center justify-between px-6 py-4 border-b" style="border-color: rgba(0,255,42,0.12); background: rgba(0,255,42,0.04);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest" style="color: var(--neon);" id="form-panel-title">Add New Tournament</h3>
        <button id="close-form-panel" class="text-gray-600 hover:text-gray-400 transition-colors" aria-label="Close form">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <form id="tournament-form" class="p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" novalidate>
        <input type="hidden" id="edit-tournament-id" value="" />

        <div class="sm:col-span-2 lg:col-span-3">
          <label for="t-title" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Tournament Title <span class="text-red-400">*</span></label>
          <input type="text" id="t-title" required placeholder="e.g. NEXUS OPEN CUP #13"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-game" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Game Name <span class="text-red-400">*</span></label>
          <input type="text" id="t-game" required placeholder="e.g. PUBG Mobile, Valorant"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-mode" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Game Mode <span class="text-red-400">*</span></label>
          <input type="text" id="t-mode" required placeholder="e.g. Squad (4v4), Battle Royale"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-slots" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Max Slots <span class="text-red-400">*</span></label>
          <input type="number" id="t-slots" required min="1" max="500" placeholder="e.g. 16"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-pp-fee" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Per Person Entry Fee (PKR) <span class="text-red-400">*</span></label>
          <input type="number" id="t-pp-fee" required min="0" placeholder="e.g. 100 (0 = free)"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-team-fee" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Team Entry Fee (PKR) <span class="text-red-400">*</span></label>
          <input type="number" id="t-team-fee" required min="0" placeholder="e.g. 350 (0 = free)"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-prize" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Prize Pool Details <span class="text-red-400">*</span></label>
          <input type="text" id="t-prize" required placeholder="e.g. PKR 10,000"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label for="t-date" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Date</label>
          <input type="text" id="t-date" placeholder="e.g. Aug 20, 2026"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div>
          <label class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Status <span class="text-red-400">*</span></label>
          <div class="grid grid-cols-2 gap-3" role="group" aria-label="Tournament status">
            <label class="cursor-pointer">
              <input type="radio" id="t-status-active" name="t_status" value="Active" class="sr-only peer" checked />
              <div class="p-3 rounded-lg border text-center transition-all duration-200 border-white/15 bg-white/[0.02] peer-checked:border-neon peer-checked:bg-neon/10 peer-checked:shadow-neon-sm hover:border-white/30 cursor-pointer">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">Active</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Registrations Open</span>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" id="t-status-disabled" name="t_status" value="Disabled" class="sr-only peer" />
              <div class="p-3 rounded-lg border text-center transition-all duration-200 border-white/15 bg-white/[0.02] peer-checked:border-red-400/60 peer-checked:bg-red-400/10 hover:border-white/30 cursor-pointer">
                <span class="font-tech font-700 text-sm tracking-wider uppercase block text-white">Disabled</span>
                <span class="font-tech text-[10px] text-gray-500 block mt-0.5">Registrations Closed</span>
              </div>
            </label>
          </div>
        </div>

        <div class="sm:col-span-2 lg:col-span-3">
          <label for="t-desc" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Description</label>
          <input type="text" id="t-desc" placeholder="Optional short description"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" />
        </div>

        <div class="sm:col-span-2 lg:col-span-3 flex items-center gap-3 pt-2 border-t" style="border-color: rgba(255,255,255,0.06);">
          <button type="submit" id="form-submit-btn" class="btn-neon px-6 py-2.5 rounded-lg text-sm tracking-[.1em] shadow-neon-sm">Save Tournament</button>
          <button type="button" id="form-cancel-btn" class="btn-outline-neon px-5 py-2.5 rounded-lg text-sm tracking-[.1em]">Cancel</button>
          <p id="form-error" class="hidden text-red-400 font-tech text-xs ml-2" role="alert">Please fill in all required fields.</p>
        </div>
      </form>
    </div>
  </div>

  <!-- Tournaments Table -->
  <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
    <div class="flex items-center justify-between px-5 py-4 border-b" style="border-color: rgba(255,255,255,0.06);">
      <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white flex items-center gap-2">
        Tournament List
        <span id="tournament-count-badge" class="font-tech text-[10px] px-2 py-0.5 rounded" style="background: rgba(0,255,42,0.1); color: var(--neon); border: 1px solid rgba(0,255,42,0.2);">0</span>
      </h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full" aria-label="Tournaments list">
        <thead>
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Title</th>
            <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden sm:table-cell">Game / Mode</th>
            <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden md:table-cell">Fees</th>
            <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600 hidden lg:table-cell">Prize / Slots</th>
            <th class="text-left px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Status</th>
            <th class="text-right px-5 py-3 font-tech text-[10px] tracking-widest uppercase text-gray-600">Actions</th>
          </tr>
        </thead>
        <tbody id="tournaments-tbody"></tbody>
      </table>
    </div>
    <div id="tournaments-empty" class="hidden px-5 py-12 text-center">
      <p class="font-tech text-sm text-gray-600 mb-3">No tournaments yet.</p>
      <button id="empty-add-btn" class="btn-outline-neon px-5 py-2 rounded-lg text-xs tracking-widest">Add Your First Tournament</button>
    </div>
  </div>

  <!-- Delete Confirm Modal -->
  <div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);">
    <div class="card-dark rounded-xl border p-6 max-w-sm w-full text-center" style="border-color: rgba(239,68,68,0.3);">
      <div class="w-12 h-12 rounded-full mx-auto mb-4 flex items-center justify-center" style="background: rgba(239,68,68,0.1);">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
      </div>
      <h4 class="font-tech font-700 text-base uppercase tracking-wide text-white mb-2">Delete Tournament?</h4>
      <p class="text-gray-400 text-sm mb-5">This action cannot be undone.</p>
      <div class="flex gap-3 justify-center">
        <button id="confirm-delete-btn" class="font-tech font-700 text-sm tracking-widest uppercase px-5 py-2.5 rounded-lg transition-all duration-200" style="background: rgba(239,68,68,0.15); color: #EF4444; border: 1px solid rgba(239,68,68,0.3);">Delete</button>
        <button id="cancel-delete-btn" class="btn-outline-neon px-5 py-2.5 rounded-lg text-sm tracking-widest">Cancel</button>
      </div>
    </div>
  </div>

</AdminLayout>

<script define:vars={{ API_BASE }}>
  let tournamentsCache = [];
  let deleteTargetId = '';

  async function fetchTournaments() {
    try {
      const token = localStorage.getItem('nexus_admin_token') || '';
      const headers = token ? { 'Authorization': `Bearer ${token}` } : {};
      const res  = await fetch(`${API_BASE}/tournaments`, { headers });
      const data = await res.json();
      if (data.success && Array.isArray(data.data)) {
        tournamentsCache = data.data;
        renderTable();
        return;
      }
      throw new Error('bad response');
    } catch (err) {
      console.warn('[Tournaments] Fetch failed:', err);
      tournamentsCache = [];
      renderTable();
    }
  }

  function renderTable() {
    const tbody      = document.getElementById('tournaments-tbody');
    const emptyEl    = document.getElementById('tournaments-empty');
    const countBadge = document.getElementById('tournament-count-badge');
    if (!tbody || !emptyEl || !countBadge) return;
    countBadge.textContent = String(tournamentsCache.length);
    tbody.innerHTML = '';

    if (tournamentsCache.length === 0) {
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');

    tournamentsCache.forEach((t) => {
      const id      = t._id || t.id || '';
      const status  = t.status || 'Active';
      const isActive = status === 'Active';
      const badgeClass = isActive ? 'badge-live' : 'badge-closed';
      const ppFee   = Number(t.perPersonFee) || 0;
      const tFee    = Number(t.teamFee) || 0;

      const tr = document.createElement('tr');
      tr.style.cssText = 'border-bottom: 1px solid rgba(255,255,255,0.04); transition: background .15s;';
      tr.innerHTML = `
        <td class="px-5 py-3.5">
          <span class="font-tech font-700 text-sm text-white">${t.title}</span>
        </td>
        <td class="px-5 py-3.5 hidden sm:table-cell">
          <span class="font-tech text-xs text-gray-300">${t.gameName || '—'}</span>
          <span class="font-tech text-xs text-gray-600 block">${t.gameMode || '—'}</span>
        </td>
        <td class="px-5 py-3.5 hidden md:table-cell">
          <span class="font-tech text-xs text-gray-400 block">Solo: ${ppFee === 0 ? 'Free' : 'PKR ' + ppFee}</span>
          <span class="font-tech text-xs text-gray-400 block">Team: ${tFee === 0 ? 'Free' : 'PKR ' + tFee}</span>
        </td>
        <td class="px-5 py-3.5 hidden lg:table-cell">
          <span class="font-tech text-xs font-700 block" style="color: var(--neon);">${t.prizePool || '—'}</span>
          <span class="font-tech text-xs text-gray-500 block">${t.maxSlots || '—'} slots</span>
        </td>
        <td class="px-5 py-3.5">
          <span class="${badgeClass} font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">${isActive ? 'Active' : 'Disabled'}</span>
        </td>
        <td class="px-5 py-3.5">
          <div class="flex items-center justify-end gap-2">
            <button data-id="${id}" data-action="toggle" title="Toggle Status"
              class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-200 text-yellow-400 hover:bg-yellow-400/10"
              style="border: 1px solid rgba(251,191,36,0.25);" aria-label="Toggle status">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            </button>
            <button data-id="${id}" data-action="edit" title="Edit"
              class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-200 hover:bg-white/10"
              style="border: 1px solid rgba(255,255,255,0.1); color: #9CA3AF;" aria-label="Edit tournament">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </button>
            <button data-id="${id}" data-action="delete" title="Delete"
              class="w-8 h-8 rounded-lg flex items-center justify-center transition-all duration-200 text-red-400 hover:bg-red-400/10"
              style="border: 1px solid rgba(239,68,68,0.2);" aria-label="Delete tournament">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
            </button>
          </div>
        </td>`;
      tr.addEventListener('mouseenter', () => tr.style.background = 'rgba(0,255,42,0.025)');
      tr.addEventListener('mouseleave', () => tr.style.background = '');
      tbody.appendChild(tr);
    });
  }

  // ── Form panel ────────────────────────────────────────────────────────
  const formPanel  = document.getElementById('tournament-form-panel');
  const formTitle  = document.getElementById('form-panel-title');
  const form       = document.getElementById('tournament-form');
  const formError  = document.getElementById('form-error');
  const editIdInput = document.getElementById('edit-tournament-id');

  function showForm(editId) {
    editId = editId || '';
    editIdInput.value = editId;
    formTitle.textContent = editId ? 'Edit Tournament' : 'Add New Tournament';
    formPanel.classList.remove('hidden');
    formPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    formError.classList.add('hidden');
    if (editId) {
      const t = tournamentsCache.find((x) => (x._id || x.id) === editId);
      if (t) {
        document.getElementById('t-title').value    = t.title       || '';
        document.getElementById('t-game').value     = t.gameName    || '';
        document.getElementById('t-mode').value     = t.gameMode    || '';
        document.getElementById('t-slots').value    = String(t.maxSlots     || '');
        document.getElementById('t-pp-fee').value   = String(t.perPersonFee || 0);
        document.getElementById('t-team-fee').value = String(t.teamFee      || 0);
        document.getElementById('t-prize').value    = t.prizePool   || '';
        document.getElementById('t-date').value     = t.date        || '';
        const statusVal = t.status || 'Active';
        const radioActive   = document.getElementById('t-status-active');
        const radioDisabled = document.getElementById('t-status-disabled');
        if (radioActive && radioDisabled) {
          radioActive.checked   = statusVal === 'Active';
          radioDisabled.checked = statusVal !== 'Active';
        }
        document.getElementById('t-desc').value = t.description || '';
      }
    } else {
      form.reset();
    }
  }

  function hideForm() {
    formPanel.classList.add('hidden');
    form.reset();
    formError.classList.add('hidden');
  }

  document.getElementById('open-add-form') && document.getElementById('open-add-form').addEventListener('click',   () => showForm());
  document.getElementById('close-form-panel') && document.getElementById('close-form-panel').addEventListener('click', hideForm);
  document.getElementById('form-cancel-btn') && document.getElementById('form-cancel-btn').addEventListener('click',  hideForm);
  document.getElementById('empty-add-btn') && document.getElementById('empty-add-btn').addEventListener('click',    () => showForm());

  // ── Form submit ───────────────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');

    const title        = document.getElementById('t-title').value.trim();
    const gameName     = document.getElementById('t-game').value.trim();
    const gameMode     = document.getElementById('t-mode').value.trim();
    const maxSlots     = parseInt(document.getElementById('t-slots').value, 10);
    const perPersonFee = parseFloat(document.getElementById('t-pp-fee').value) || 0;
    const teamFee      = parseFloat(document.getElementById('t-team-fee').value) || 0;
    const prizePool    = document.getElementById('t-prize').value.trim();
    const date         = document.getElementById('t-date').value.trim();
    const statusRadio  = document.querySelector('input[name="t_status"]:checked');
    const status       = statusRadio ? statusRadio.value : 'Active';
    const description  = document.getElementById('t-desc').value.trim();

    if (!title || !gameName || !gameMode || !maxSlots || !prizePool) {
      formError.classList.remove('hidden');
      return;
    }

    const payload = { title, gameName, gameMode, maxSlots, perPersonFee, teamFee, prizePool, date, status, description };
    const editId  = editIdInput.value;

    const token = localStorage.getItem('nexus_admin_token') || '';
    const authHeaders = {
      'Content-Type': 'application/json',
      ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
    };

    const submitBtn = document.getElementById('form-submit-btn');
    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';

    try {
      let res;
      if (editId) {
        res = await fetch(`${API_BASE}/tournaments/${editId}`, { method: 'PUT', headers: authHeaders, body: JSON.stringify(payload) });
      } else {
        res = await fetch(`${API_BASE}/tournaments`, { method: 'POST', headers: authHeaders, body: JSON.stringify(payload) });
      }
      let data;
      try { data = await res.json(); } catch (_) { data = {}; }

      if (res.ok && data.success) {
        await fetchTournaments();
        showToast(editId ? 'Tournament updated.' : 'Tournament created!');
        hideForm();
      } else {
        showToast(data.message || 'Error saving tournament.', true);
      }
    } catch (err) {
      console.error('[Tournaments] Submit error:', err);
      showToast('Backend offline — please start the server.', true);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });

  // ── Table action delegation ───────────────────────────────────────────
  document.getElementById('tournaments-tbody') && document.getElementById('tournaments-tbody').addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const id     = btn.dataset.id;
    const action = btn.dataset.action;

    const token = localStorage.getItem('nexus_admin_token') || '';
    const authHeaders = {
      'Content-Type': 'application/json',
      ...(token ? { 'Authorization': `Bearer ${token}` } : {}),
    };

    if (action === 'edit') {
      showForm(id);
    } else if (action === 'delete') {
      deleteTargetId = id;
      const modal = document.getElementById('delete-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } else if (action === 'toggle') {
      const t = tournamentsCache.find((x) => (x._id || x.id) === id);
      if (!t) return;
      const newStatus = (t.status === 'Active') ? 'Disabled' : 'Active';
      try {
        const res = await fetch(`${API_BASE}/tournaments/${id}`, {
          method: 'PUT',
          headers: authHeaders,
          body: JSON.stringify({ status: newStatus }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          await fetchTournaments();
          showToast(`Status → ${newStatus}`);
        } else {
          showToast(data.message || 'Could not update status.', true);
        }
      } catch {
        showToast('Could not update status. Backend offline.', true);
      }
    }
  });

  document.getElementById('confirm-delete-btn') && document.getElementById('confirm-delete-btn').addEventListener('click', async () => {
    const token = localStorage.getItem('nexus_admin_token') || '';
    const authHeaders = token ? { 'Authorization': `Bearer ${token}` } : {};
    try {
      const res = await fetch(`${API_BASE}/tournaments/${deleteTargetId}`, {
        method: 'DELETE',
        headers: authHeaders,
      });
      const data = await res.json();
      if (res.ok && data.success) {
        await fetchTournaments();
        showToast('Tournament deleted.');
      } else {
        showToast(data.message || 'Could not delete.', true);
      }
    } catch {
      showToast('Could not delete. Backend offline.', true);
    }
    closeDeleteModal();
  });

  document.getElementById('cancel-delete-btn') && document.getElementById('cancel-delete-btn').addEventListener('click', closeDeleteModal);
  document.getElementById('delete-modal') && document.getElementById('delete-modal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('delete-modal')) closeDeleteModal();
  });

  function closeDeleteModal() {
    const m = document.getElementById('delete-modal');
    m.classList.add('hidden');
    m.classList.remove('flex');
    deleteTargetId = '';
  }

  function showToast(msg, isError) {
    isError = isError || false;
    const existing = document.getElementById('admin-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'admin-toast';
    const color = isError ? 'rgba(239,68,68' : 'rgba(0,255,42';
    toast.style.cssText = `position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;font-family:"Rajdhani",sans-serif;font-size:.875rem;padding:.75rem 1.25rem;border-radius:.5rem;background:${color},0.15);border:1px solid ${color},0.35);color:${isError?'#EF4444':'var(--neon)'};transition:opacity .3s;`;
    toast.setAttribute('role', 'status');
    toast.setAttribute('aria-live', 'polite');
    toast.textContent = `${isError ? '✕' : '✓'}  ${msg}`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
  }

  // Guard against the Astro timing edge case where DOMContentLoaded already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchTournaments);
  } else {
    fetchTournaments();
  }
</script>
