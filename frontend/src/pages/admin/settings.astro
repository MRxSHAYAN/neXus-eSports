---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Settings" activePage="settings">

  <div class="mb-8">
    <div class="flex items-center gap-3 mb-1">
      <div class="w-4 h-px" style="background: var(--neon);"></div>
      <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Admin</span>
    </div>
    <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Panel <span style="color: var(--neon);">Settings</span></h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-4xl">

    <!-- Admin Account -->
    <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
      <div class="px-5 py-4 border-b" style="border-color: rgba(255,255,255,0.06);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white">Admin Account</h3>
      </div>
      <div class="p-5 space-y-4">
        <div class="flex items-center gap-4 p-4 rounded-lg" style="background: rgba(0,255,42,0.05); border: 1px solid rgba(0,255,42,0.15);">
          <div class="w-12 h-12 rounded-full flex items-center justify-center font-tech font-700 text-lg flex-shrink-0" style="background: var(--neon); color: #05070A;">A</div>
          <div>
            <p class="font-tech font-700 text-sm text-white">admin</p>
            <p class="font-tech text-xs text-gray-500 mt-0.5">Super Administrator</p>
          </div>
          <span class="ml-auto badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Active</span>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-lg border" style="background: rgba(251,191,36,0.05); border-color: rgba(251,191,36,0.2);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p class="font-tech text-xs text-yellow-400/80 leading-relaxed">
            To change admin credentials, update the <code class="text-yellow-300 bg-black/30 px-1 py-0.5 rounded text-[10px]">.env</code> file in the backend directory and restart the server.
          </p>
        </div>
      </div>
    </div>

    <!-- Site Config -->
    <div class="card-dark rounded-xl border overflow-hidden" style="border-color: rgba(0,255,42,0.1);">
      <div class="px-5 py-4 border-b" style="border-color: rgba(255,255,255,0.06);">
        <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white">Site Configuration</h3>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-2">Organization Name</label>
          <input type="text" value="NEXUS ESPORTS" readonly
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-gray-400 cursor-not-allowed"
            style="background: rgba(5,7,10,0.5); border: 1px solid rgba(255,255,255,0.06);" />
        </div>
        <div class="flex items-center justify-between py-2">
          <div>
            <p class="font-tech text-sm text-white">Registration Toggle</p>
            <p class="font-tech text-xs text-gray-500 mt-0.5">Enable/disable registrations via tournament status in the Tournaments page.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-lg border" style="background: rgba(0,255,42,0.03); border-color: rgba(0,255,42,0.1);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00FF2A" stroke-width="2" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <p class="font-tech text-xs text-neon/70 leading-relaxed">
            To open/close registrations for a specific tournament, go to <a href="/admin/tournaments" class="text-neon hover:underline font-700">Manage Tournaments</a> and toggle its status.
          </p>
        </div>
      </div>
    </div>

    <!-- Backend Info -->
    <div class="card-dark rounded-xl border p-5 lg:col-span-2" style="border-color: rgba(0,255,42,0.08);">
      <h3 class="font-tech font-700 text-sm uppercase tracking-widest text-white mb-4">Backend Configuration</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
        <div class="bg-white/[0.02] rounded-lg px-4 py-3 border border-white/5">
          <p class="font-tech text-[10px] text-gray-500 tracking-widest uppercase mb-1">API Port</p>
          <p class="font-tech font-700 text-white">5000</p>
        </div>
        <div class="bg-white/[0.02] rounded-lg px-4 py-3 border border-white/5">
          <p class="font-tech text-[10px] text-gray-500 tracking-widest uppercase mb-1">Database</p>
          <p class="font-tech font-700 text-white">MongoDB</p>
        </div>
        <div class="bg-white/[0.02] rounded-lg px-4 py-3 border border-white/5">
          <p class="font-tech text-[10px] text-gray-500 tracking-widest uppercase mb-1">Auth</p>
          <p class="font-tech font-700 text-white">JWT (12h)</p>
        </div>
      </div>
      <div class="flex items-start gap-3 mt-4 p-3 rounded-lg border" style="background: rgba(251,191,36,0.05); border-color: rgba(251,191,36,0.15);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FBBF24" stroke-width="2" class="flex-shrink-0 mt-0.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <p class="font-tech text-xs text-gray-500 leading-relaxed">
          All sensitive configuration (credentials, DB URI, JWT secret) is managed through the <code class="text-yellow-400 bg-black/30 px-1 py-0.5 rounded text-[10px]">backend/.env</code> file. Never commit this file to version control.
        </p>
      </div>
    </div>

  </div>

</AdminLayout>

<script>
  function showToast(msg: string, isError = false) {
    const existing = document.getElementById('admin-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'admin-toast';
    const color = isError ? 'rgba(239,68,68' : 'rgba(0,255,42';
    toast.style.cssText = `position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;font-family:"Rajdhani",sans-serif;font-size:.875rem;padding:.75rem 1.25rem;border-radius:.5rem;background:${color},0.15);border:1px solid ${color},0.35);color:${isError?'#EF4444':'var(--neon)'};transition:opacity .3s;`;
    toast.textContent = `${isError ? '✕' : '✓'}  ${msg}`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 2500);
  }
</script>
