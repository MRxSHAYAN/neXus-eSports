---
import AdminLayout from '../../layouts/AdminLayout.astro';
const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000/api';
---

<AdminLayout title="Bank Accounts & Payment Settings" activePage="bank">

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <div class="w-4 h-px" style="background: var(--neon);"></div>
        <span class="font-tech text-[11px] tracking-[.2em] uppercase" style="color: rgba(0,255,42,0.6);">Admin</span>
      </div>
      <h2 class="font-tech font-700 text-2xl sm:text-3xl uppercase text-white tracking-wide">Bank <span style="color: var(--neon);">Settings</span></h2>
      <p class="font-tech text-xs text-gray-400 mt-1">Configure the 2 active payment accounts shown to registering players.</p>
    </div>
    <div id="bank-server-status" class="flex items-center gap-2 px-3.5 py-2 rounded-full border" style="background: rgba(0,255,42,0.08); border-color: rgba(0,255,42,0.2);">
      <span class="w-2.5 h-2.5 rounded-full bg-neon animate-pulse"></span>
      <span class="font-tech text-xs tracking-wider uppercase text-neon" id="bank-status-text">Checking API...</span>
    </div>
  </div>

  <form id="bank-settings-form" class="space-y-6 max-w-3xl">

    <!-- Account 1 -->
    <div class="card-dark rounded-xl border p-6" style="border-color: rgba(0,255,42,0.15);">
      <div class="flex items-center gap-3 mb-5 pb-4 border-b border-white/5">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center font-tech font-700 text-base flex-shrink-0" style="background: rgba(0,255,42,0.15); color: var(--neon); border: 1px solid rgba(0,255,42,0.25);">1</div>
        <div>
          <h3 class="font-tech font-700 text-base uppercase tracking-wider text-white">Account 1</h3>
          <p class="font-tech text-xs text-gray-500 mt-0.5">e.g. JazzCash, EasyPaisa</p>
        </div>
        <span class="ml-auto badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Active</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="a1-provider" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Bank / Provider Name <span class="text-red-400">*</span></label>
          <input type="text" id="a1-provider" name="a1_provider" placeholder="e.g. JazzCash"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
        <div>
          <label for="a1-title" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Account Title <span class="text-red-400">*</span></label>
          <input type="text" id="a1-title" name="a1_title" placeholder="e.g. NEXUS ESPORTS"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
        <div>
          <label for="a1-number" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Account Number <span class="text-red-400">*</span></label>
          <input type="text" id="a1-number" name="a1_number" placeholder="03XX-XXXXXXX"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
      </div>
    </div>

    <!-- Account 2 -->
    <div class="card-dark rounded-xl border p-6" style="border-color: rgba(0,255,42,0.15);">
      <div class="flex items-center gap-3 mb-5 pb-4 border-b border-white/5">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center font-tech font-700 text-base flex-shrink-0" style="background: rgba(0,255,42,0.15); color: var(--neon); border: 1px solid rgba(0,255,42,0.25);">2</div>
        <div>
          <h3 class="font-tech font-700 text-base uppercase tracking-wider text-white">Account 2</h3>
          <p class="font-tech text-xs text-gray-500 mt-0.5">e.g. Bank Account, SadaPay</p>
        </div>
        <span class="ml-auto badge-live font-tech text-[10px] font-700 tracking-widest uppercase px-2 py-0.5 rounded">Active</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="a2-provider" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Bank / Provider Name <span class="text-red-400">*</span></label>
          <input type="text" id="a2-provider" name="a2_provider" placeholder="e.g. SadaPay"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
        <div>
          <label for="a2-title" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Account Title <span class="text-red-400">*</span></label>
          <input type="text" id="a2-title" name="a2_title" placeholder="e.g. NEXUS ESPORTS"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
        <div>
          <label for="a2-number" class="block font-tech text-xs tracking-widest uppercase text-gray-400 mb-1.5">Account Number <span class="text-red-400">*</span></label>
          <input type="text" id="a2-number" name="a2_number" placeholder="IBAN / Mobile / Number"
            class="input-neon w-full px-4 py-2.5 rounded-lg font-tech text-sm text-white placeholder-gray-600 transition-colors"
            style="background: rgba(5,7,10,0.8); border: 1px solid rgba(255,255,255,0.1);" required />
        </div>
      </div>
    </div>

    <div class="flex items-center gap-4 pt-2">
      <button type="submit" id="save-bank-btn" class="btn-neon px-8 py-3.5 rounded-lg text-sm tracking-[.15em] font-tech font-700 uppercase shadow-neon">
        Save Bank Settings
      </button>
      <span id="bank-save-loader" class="hidden font-tech text-xs text-neon animate-pulse">Saving...</span>
    </div>

  </form>

</AdminLayout>

<script define:vars={{ API_BASE }}>

  function showToast(msg: string, isError = false) {
    const existing = document.getElementById('admin-toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.id = 'admin-toast';
    const color = isError ? 'rgba(239,68,68' : 'rgba(0,255,42';
    toast.style.cssText = `position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;font-family:"Rajdhani",sans-serif;font-size:.875rem;padding:.75rem 1.25rem;border-radius:.5rem;background:${color},0.15);border:1px solid ${color},0.35);color:${isError?'#EF4444':'var(--neon)'};transition:opacity .3s;`;
    toast.setAttribute('role', 'status');
    toast.textContent = `${isError ? '✕' : '✓'}  ${msg}`;
    document.body.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
  }

  async function loadBankSettings() {
    const statusText  = document.getElementById('bank-status-text') as HTMLSpanElement;
    const statusBadge = document.getElementById('bank-server-status') as HTMLDivElement;
    try {
      const res  = await fetch(`${API_BASE}/bank`);
      if (!res.ok) throw new Error('non-200');
      const result = await res.json();
      if (result.success && result.data) {
        const { account1, account2 } = result.data;
        (document.getElementById('a1-provider') as HTMLInputElement).value = account1?.provider || '';
        (document.getElementById('a1-title') as HTMLInputElement).value    = account1?.title    || '';
        (document.getElementById('a1-number') as HTMLInputElement).value   = account1?.number   || '';
        (document.getElementById('a2-provider') as HTMLInputElement).value = account2?.provider || '';
        (document.getElementById('a2-title') as HTMLInputElement).value    = account2?.title    || '';
        (document.getElementById('a2-number') as HTMLInputElement).value   = account2?.number   || '';
        if (statusText) statusText.textContent = 'Backend Live';
      }
    } catch {
      if (statusText) statusText.textContent = 'Backend Offline';
      if (statusBadge) {
        statusBadge.style.background   = 'rgba(239,68,68,0.1)';
        statusBadge.style.borderColor  = 'rgba(239,68,68,0.3)';
        if (statusText) statusText.style.color = '#EF4444';
      }
    }
  }

  const form   = document.getElementById('bank-settings-form') as HTMLFormElement;
  const loader = document.getElementById('bank-save-loader') as HTMLSpanElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    loader.classList.remove('hidden');

    const payload = {
      account1: {
        provider: (document.getElementById('a1-provider') as HTMLInputElement).value.trim(),
        title:    (document.getElementById('a1-title') as HTMLInputElement).value.trim(),
        number:   (document.getElementById('a1-number') as HTMLInputElement).value.trim(),
      },
      account2: {
        provider: (document.getElementById('a2-provider') as HTMLInputElement).value.trim(),
        title:    (document.getElementById('a2-title') as HTMLInputElement).value.trim(),
        number:   (document.getElementById('a2-number') as HTMLInputElement).value.trim(),
      },
    };

    try {
      const res = await fetch(`${API_BASE}/bank`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('failed');
      showToast('Bank settings saved!');
    } catch {
      showToast('Backend offline. Please start the server.', true);
    } finally {
      loader.classList.add('hidden');
    }
  });

  document.addEventListener('DOMContentLoaded', loadBankSettings);
</script>
