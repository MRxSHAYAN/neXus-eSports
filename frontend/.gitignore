# ───────────────────────────────────────────
#  NEXUS ESPORTS — .gitignore
#  Everything listed here is excluded from
#  version control (GitHub will never see it)
# ───────────────────────────────────────────

# ── Build Output ────────────────────────────
# Astro compiles your site into /dist
# No point committing compiled files — they're
# regenerated on every build / deploy.
dist/
.output/

# ── Astro Generated Types ───────────────────
# Auto-generated by `astro dev` / `astro build`
# Safe to delete anytime; Astro recreates them.
.astro/

# ── Node Modules ────────────────────────────
# All npm packages. Reinstall with `npm install`.
# Never commit this — it can be 300MB+.
node_modules/

# ── Environment Variables ───────────────────
# Secret keys, API tokens, DB passwords.
# NEVER commit these. Add real values locally.
.env
.env.local
.env.development
.env.production
.env.staging
*.env

# ── Logs ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS / Editor Junk ────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverridecom

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ── Editor Config ───────────────────────────
# JetBrains (WebStorm, IntelliJ)
.idea/

# VSCode local settings (keep .vscode/extensions.json if you want)
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace

# ── Temp / Cache ────────────────────────────
.cache/
.temp/
.tmp/
*.tmp
*.bak
*.swp

# ── Project-specific: Explainer Doc ─────────
# This file is for your personal reference only.
# It doesn't affect the website — keep it local.
NEXUS_EXPLAINER.md
